---
import { urlFor } from "../lib/image";

interface Props {
	member: any;
	isLead?: boolean;
}

const { member, isLead = false } = Astro.props;
---

<div
	class="flex flex-col items-center rounded-xl border border-stone-200 bg-white p-6 text-center shadow-sm"
>
	{
		member.photo ? (
			<img
				src={urlFor(member.photo)
					.width(200)
					.height(200)
					.fit("crop")
					.url()}
				alt={member.name}
				width="200"
				height="200"
				class="h-20 w-20 rounded-full object-cover"
				loading="lazy"
			/>
		) : (
			<div class="flex h-20 w-20 items-center justify-center rounded-full bg-gradient-to-br from-brand-100 to-brand-50">
				<span class="text-2xl font-bold text-brand-400">
					{(member.name ?? "?").charAt(0).toUpperCase()}
				</span>
			</div>
		)
	}
	<h3 class="mt-4 text-base font-semibold text-stone-900">{member.name}</h3>
	{member.role && <p class="mt-1 text-sm text-stone-600">{member.role}</p>}
	{
		isLead && (
			<span class="mt-3 inline-flex items-center rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700">
				Project Lead
			</span>
		)
	}
</div>
