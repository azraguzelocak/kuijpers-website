---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
	getAllServices,
	getAllResearchProjects,
	getAllAdvantages,
	getAllPublications,
} from "../../lib/sanity";
import { urlFor } from "../../lib/image";
import { INNOVATIONS, CATEGORY_META } from "../../data/innovations";
import PartnersMarquee from "../PartnersMarquee.astro";
import { PRESS } from "../../data/press";
import { getLangFromUrl, useTranslations, localizePath } from "../../i18n/utils";
import { translateCms } from "../../i18n/cms";

// --- Data fetching ------------------------------------------------------
const services = (await getAllServices()) ?? [];
const allResearch = (await getAllResearchProjects()) ?? [];
const advantages = (await getAllAdvantages()) ?? [];
const allPublications = (await getAllPublications()) ?? [];

// Featured research: 3 most recent (query is already ordered).
const featuredResearch = allResearch.slice(0, 3);
// Latest publications: 3 most recent (query is already ordered).
const latestPublications = allPublications.slice(0, 3);
// Featured innovations for the home teaser (from src/data/innovations.ts, not Sanity).
const featuredInnovations = INNOVATIONS.slice(0, 3);

// Press coverage (src/data/press.ts). Entries still flagged `example: true` are
// visible while developing but never built into the live site, so placeholder
// coverage cannot ship; the section disappears when nothing real is left.
const press = PRESS.filter((item) => import.meta.env.DEV || !item.example);
const pressDate = (iso: string) =>
	new Date(iso).toLocaleDateString(
		lang === "nl" ? "nl-NL" : lang === "de" ? "de-DE" : lang === "fr" ? "fr-FR" : "en-GB",
		{ month: "long", year: "numeric" },
	);
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// --- Publication helpers ------------------------------------------------
const TYPE_META: Record<string, { label: string; badge: string }> = {
	paper: { label: "Paper", badge: "bg-brand-100 text-brand-800 ring-brand-600/20" },
	report: {
		label: "Report",
		badge: "bg-emerald-100 text-emerald-800 ring-emerald-600/20",
	},
	article: {
		label: "Article",
		badge: "bg-amber-100 text-amber-800 ring-amber-600/20",
	},
};
const typeMeta = (type: string) =>
	TYPE_META[type] ?? {
		label: type ?? "Other",
		badge: "bg-stone-100 text-stone-700 ring-stone-500/20",
	};

// Combine linked team authors and free-text authors into one byline.
const authorNames = (pub: any): string => {
	const team = (pub.teamAuthors ?? []).map((a: any) => a?.name).filter(Boolean);
	const free = Array.isArray(pub.authors)
		? pub.authors.filter(Boolean)
		: pub.authors
			? [pub.authors]
			: [];
	return [...team, ...free].join(", ");
};

// Status badge styling for research cards.
const statusStyles: Record<string, string> = {
	ongoing: "bg-brand-50 text-brand-700",
	completed: "bg-emerald-50 text-emerald-700",
	planned: "bg-amber-50 text-amber-700",
};
const statusLabel = (s?: string) => {
	if (s === "ongoing") return t("res.status.ongoing");
	if (s === "completed") return t("res.status.completed");
	if (s === "planned") return t("res.status.planned");
	return s ? s.charAt(0).toUpperCase() + s.slice(1) : "Research";
};

// Fallback stats so the advantages strip stays visually balanced before the
// `stat`/`description` fields are populated in the CMS.
const advantageFallbacks = [
	{ stat: "20%", description: t("svc.stat.1") },
	{ stat: "24/7", description: t("svc.stat.2") },
	{ stat: "100%", description: t("svc.stat.3") },
	{ stat: "3×", description: t("svc.stat.4") },
];

// Date formatter for news teasers.
const formatDate = (value?: string) =>
	value
		? new Date(value).toLocaleDateString("en-GB", {
				day: "numeric",
				month: "long",
				year: "numeric",
			})
		: "";
---

<BaseLayout
	title={t("home.meta.title")}
	description={t("home.meta.desc")}
>
	<!-- 1. Hero -->
	<section class="hero-full relative flex items-center overflow-hidden bg-stone-900 sm:min-h-[calc(100svh-7rem)]">
		<!-- Full-bleed background photograph -->
		<img
			src="/images/hero.jpg"
			alt=""
			aria-hidden="true"
			class="absolute inset-0 h-full w-full object-cover object-center"
			loading="eager"
		/>
		<!-- Cinematic dark overlay for legibility (stronger on the left) -->
		<div
			class="absolute inset-0 bg-gradient-to-r from-stone-950/70 via-stone-950/45 to-stone-900/20"
		>
		</div>
		<div
			class="absolute inset-0 bg-gradient-to-t from-stone-950/55 via-transparent to-stone-950/15"
		>
		</div>

		<!-- Digital-twin accent: thin data lines + glowing measurement points -->
		<svg
			class="pointer-events-none absolute inset-0 h-full w-full text-brand-400"
			viewBox="0 0 1200 600"
			preserveAspectRatio="xMidYMid slice"
			fill="none"
			aria-hidden="true"
		>
			<g stroke="currentColor" stroke-width="1" opacity="0.25">
				<path d="M0 120 H1200" />
				<path d="M0 300 H1200" />
				<path d="M0 480 H1200" />
				<path d="M820 0 L1050 600" />
				<path d="M980 0 L760 600" />
			</g>
			<g fill="currentColor">
				<circle cx="820" cy="120" r="4" class="hero-node" />
				<circle cx="1050" cy="300" r="4" class="hero-node hero-node-2" />
				<circle cx="760" cy="480" r="4" class="hero-node hero-node-3" />
				<circle cx="980" cy="300" r="3" class="hero-node hero-node-2" />
			</g>
		</svg>

		<div
			class="relative mx-auto w-full max-w-7xl px-4 py-10 sm:px-6 lg:px-8"
		>
			<div class="max-w-3xl">
				<h1
					class="text-4xl font-extrabold tracking-tight text-white sm:text-6xl lg:text-7xl"
				>
					{t("home.hero.titleA")}<span class="text-brand-300">{t("home.hero.titleHl")}</span>.
				</h1>
				<p
					class="mt-6 max-w-[640px] text-lg leading-[1.65] text-stone-200 sm:text-xl"
				>
					{t("home.hero.subtitle")}
				</p>
				<div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
					<a
						href="/services"
						class="w-full rounded-lg bg-brand-600 px-7 py-3.5 text-center text-base font-semibold text-white shadow-sm transition-colors hover:bg-brand-700 sm:w-auto"
					>
						{t("home.hero.cta1")}
					</a>
					<a
						href="/contact"
						class="w-full rounded-lg border border-white/40 px-7 py-3.5 text-center text-base font-semibold text-white transition-colors hover:bg-white/10 sm:w-auto"
					>
						{t("home.hero.cta2")}
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- 2. Mission -->
	<section class="bg-white">
		<div class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6 lg:px-8">
			<span
				class="text-sm font-semibold uppercase tracking-wider text-brand-600"
			>
				{t("home.mission.eyebrow")}
			</span>
			<h2
				class="mt-4 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl"
			>
				{t("home.mission.title")}
			</h2>
			<p class="mt-6 text-lg leading-relaxed text-stone-600">
				{t("home.mission.text")}
			</p>
		</div>
	</section>

	<!-- 3. Services preview -->
	<section class="bg-stone-50">
		<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-2xl text-center">
				<span
					class="text-sm font-semibold uppercase tracking-wider text-brand-600"
				>
					{t("home.services.eyebrow")}
				</span>
				<h2
					class="mt-4 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl"
				>
					{t("home.services.title")}
				</h2>
			</div>

			<div
				class="swipe-row mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4"
			>
				{
					services.map((service: any) => (
						<div class="flex flex-col overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm transition-shadow hover:shadow-md">
							{service.image ? (
								<img
									src={urlFor(service.image)
										.width(600)
										.height(360)
										.fit("crop")
										.url()}
									alt={service.image.alt ?? translateCms(service.title, lang)}
									width="600"
									height="360"
									class="aspect-[5/3] w-full object-cover"
									loading="lazy"
								/>
							) : (
								<div class="flex aspect-[5/3] w-full items-center justify-center bg-gradient-to-br from-brand-100 to-brand-50">
									<span class="text-sm font-medium text-brand-400">
										Kuijpers Kip Research Field
									</span>
								</div>
							)}
							<div class="flex flex-1 flex-col p-6">
								<h3 class="text-lg font-semibold text-stone-900">
									{translateCms(service.title, lang)}
								</h3>
								<p class="mt-2 flex-1 text-sm leading-relaxed text-stone-600">
									{translateCms(service.shortDescription, lang)}
								</p>
								<a
									href="/services"
									class="mt-4 inline-flex items-center text-sm font-semibold text-brand-600 transition-colors hover:text-brand-700"
								>
									{t("home.services.learnMore")} &rarr;
								</a>
							</div>
						</div>
					))
				}
			</div>

			<div class="mt-12 text-center">
				<a
					href="/services"
					class="inline-flex items-center text-base font-semibold text-brand-600 transition-colors hover:text-brand-700"
				>
					{t("home.services.seeAll")} &rarr;
				</a>
			</div>
		</div>
	</section>

	<!-- 4. Featured research -->
	<section class="bg-white">
		<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-2xl text-center">
				<span
					class="text-sm font-semibold uppercase tracking-wider text-brand-600"
				>
					{t("home.research.eyebrow")}
				</span>
				<h2
					class="mt-4 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl"
				>
					{t("home.research.title")}
				</h2>
			</div>

			<div class="swipe-row mt-12 grid grid-cols-1 gap-8 lg:grid-cols-3">
				{
					featuredResearch.map((project: any) => (
						<a
							href={`/research/${project.slug}`}
							class="group flex flex-col overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm transition-shadow hover:shadow-md"
						>
							{project.coverImage ? (
								<img
									src={urlFor(project.coverImage)
										.width(800)
										.height(500)
										.fit("crop")
										.url()}
									alt={translateCms(project.title, lang)}
									width="800"
									height="500"
									class="aspect-[8/5] w-full object-cover"
									loading="lazy"
								/>
							) : (
								<div class="flex aspect-[8/5] w-full items-center justify-center bg-gradient-to-br from-brand-100 to-brand-50">
									<span class="text-sm font-medium text-brand-400">
										Kuijpers Kip Research Field
									</span>
								</div>
							)}
							<div class="flex flex-1 flex-col p-6">
								<span
									class={`inline-flex w-fit rounded-full px-3 py-1 text-xs font-semibold ${statusStyles[project.status] ?? "bg-stone-100 text-stone-600"}`}
								>
									{statusLabel(project.status)}
								</span>
								<h3 class="mt-4 text-xl font-semibold text-stone-900 transition-colors group-hover:text-brand-700">
									{translateCms(project.title, lang)}
								</h3>
								<p class="mt-2 flex-1 text-sm leading-relaxed text-stone-600">
									{translateCms(project.summary, lang)}
								</p>
								<span class="mt-4 inline-flex items-center text-sm font-semibold text-brand-600">
									{t("home.research.readMore")} &rarr;
								</span>
							</div>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<!-- 5. Advantages strip -->
	<section class="bg-brand-950 text-white">
		<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
			<div
				class="grid grid-cols-1 gap-10 text-center sm:grid-cols-2 lg:grid-cols-4"
			>
				{
					advantages.slice(0, 4).map((advantage: any, i: number) => (
						<div class="flex flex-col items-center">
							<p class="text-5xl font-extrabold tracking-tight text-white">
								{advantage.stat ??
									advantageFallbacks[i]?.stat ??
									"—"}
							</p>
							<p class="mt-3 text-lg font-semibold text-brand-100">
								{translateCms(advantage.title, lang)}
							</p>
							<p class="mt-2 text-sm leading-relaxed text-brand-200">
								{advantage.description ??
									advantageFallbacks[i]?.description ??
									""}
							</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- 5b. In the press -->
	{
		press.length > 0 && (
			<section class="bg-stone-50">
				<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
					<div class="mx-auto max-w-2xl text-center">
						<span class="text-sm font-semibold uppercase tracking-wider text-brand-600">
							{t("home.press.eyebrow")}
						</span>
						<h2 class="mt-4 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl">
							{t("home.press.title")}
						</h2>
						<p class="mx-auto mt-4 max-w-xl text-stone-600">
							{t("home.press.subtitle")}
						</p>
					</div>

					<div class="swipe-row mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
						{press.map((item) => (
							<a
								href={item.url}
								target="_blank"
								rel="noopener noreferrer"
								class="group flex flex-col rounded-xl border border-stone-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md"
							>
								<div class="flex flex-wrap items-center gap-2">
									<span class="text-sm font-semibold text-brand-700">
										{item.outlet}
									</span>
									{item.language && (
										<span class="rounded-full bg-stone-100 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-stone-500">
											{item.language}
										</span>
									)}
								</div>
								<h3 class="mt-2 text-lg font-semibold leading-snug text-stone-900">
									{item.title}
								</h3>
								<p class="mt-2 flex-1 text-sm leading-relaxed text-stone-600">
									{item.summary}
								</p>
								<div class="mt-5 flex items-center justify-between gap-3">
									<span class="text-xs font-medium uppercase tracking-wider text-stone-400">
										{pressDate(item.date)}
									</span>
									<span class="inline-flex items-center gap-1 text-sm font-semibold text-brand-600 transition-colors group-hover:text-brand-700">
										{t("home.press.read")} &rarr;
									</span>
								</div>
							</a>
						))}
					</div>
				</div>
			</section>
		)
	}

	<!-- 6. Partner logos -->
	<section class="bg-white">
		<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
			<p
				class="text-center text-sm font-semibold uppercase tracking-wider text-stone-500"
			>
				{t("home.partners.trusted")}
			</p>
			<div class="mt-10">
				<PartnersMarquee fade="#ffffff" />
			</div>
		</div>
	</section>

	<!-- 7. Latest publications -->
	<section class="bg-stone-50">
		<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-2xl text-center">
				<span
					class="text-sm font-semibold uppercase tracking-wider text-brand-600"
				>
					{t("home.innov.eyebrow")}
				</span>
				<h2
					class="mt-4 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl"
				>
					{t("home.innov.title")}
				</h2>
			</div>

			<div class="swipe-row mt-12 grid grid-cols-1 gap-8 lg:grid-cols-3">
				{featuredInnovations.map((inn) => {
					const cat = CATEGORY_META[inn.category];
					return (
						<a
							href={localizePath(`/innovations/${inn.id}`, lang)}
							class="group flex flex-col rounded-xl border border-stone-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md"
						>
							<div class="flex flex-wrap items-center gap-3">
								<span
									class="inline-flex items-center gap-2 rounded-full px-3 py-1 text-xs font-semibold"
									style={`background:${cat.color}1a;color:${cat.color}`}
								>
									<span class="h-2 w-2 rounded-full" style={`background:${cat.color}`} />
									{translateCms(cat.label, lang)}
								</span>
							</div>
							<h3 class="mt-3 text-lg font-semibold text-stone-900 transition-colors group-hover:text-brand-700">
								{translateCms(inn.name, lang)}
							</h3>
							<p class="mt-2 flex-1 text-sm leading-relaxed text-stone-600">
								{translateCms(inn.description, lang)}
							</p>
							<span class="mt-4 inline-flex items-center text-sm font-semibold text-brand-600">
								{t("home.innov.view")} &rarr;
							</span>
						</a>
					);
				})}
			</div>

			<div class="mt-12 text-center">
				<a
					href="/innovations"
					class="inline-flex items-center text-base font-semibold text-brand-600 transition-colors hover:text-brand-700"
				>
					{t("home.innov.seeAll")} &rarr;
				</a>
			</div>
		</div>
	</section>

	<!-- 8. Final CTA -->
	<section class="bg-brand-800">
		<div
			class="mx-auto max-w-7xl px-4 py-20 text-center sm:px-6 lg:px-8"
		>
			<h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
				{t("home.cta.title")}
			</h2>
			<p
				class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-brand-100"
			>
				{t("home.cta.text")}
			</p>
			<div class="mt-10">
				<a
					href="/contact"
					class="inline-block rounded-lg bg-white px-8 py-3 text-base font-semibold text-brand-800 shadow-sm transition-colors hover:bg-stone-100"
				>
					{t("home.cta.button")}
				</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	/* Softly glowing/pulsing measurement points on the hero data overlay. */
	.hero-node {
		animation: hero-glow 3s ease-in-out infinite;
		filter: drop-shadow(0 0 4px currentColor);
	}
	.hero-node-2 {
		animation-delay: 1s;
	}
	.hero-node-3 {
		animation-delay: 2s;
	}
	@keyframes hero-glow {
		0%,
		100% {
			opacity: 0.35;
		}
		50% {
			opacity: 1;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.hero-node {
			animation: none;
			opacity: 0.7;
		}
	}
</style>
