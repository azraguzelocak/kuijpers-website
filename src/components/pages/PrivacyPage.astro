---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSiteSettings } from "../../lib/sanity";
import { getLangFromUrl, localizePath } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";

// --- Data fetching ------------------------------------------------------
const settings = (await getSiteSettings()) ?? {};
const company: string = settings.siteTitle ?? "Kuijpers Research Field";
const email: string = settings.email ?? "jan@kuijperskip.com";
const phone: string = settings.phone ?? "+31 (0)6 28427410";
const address: string =
	settings.address ?? "Witveldweg 35\nGrubbenvorst\nThe Netherlands";
const telHref = phone.replace(/[^+\d]/g, "");

const lang = getLangFromUrl(Astro.url);
const cookiesHref = localizePath("/cookies", lang);

const meta = {
	en: {
		eyebrow: "Legal",
		title: "Privacy Policy",
		updatedLabel: "Last updated:",
		date: "29 May 2026",
		metaTitle: `Privacy Policy — ${company}`,
		metaDesc: `How ${company} collects, uses, stores and protects your personal data, and the rights you have under the GDPR.`,
	},
	nl: {
		eyebrow: "Juridisch",
		title: "Privacybeleid",
		updatedLabel: "Laatst bijgewerkt:",
		date: "29 mei 2026",
		metaTitle: `Privacybeleid — ${company}`,
		metaDesc: `Hoe ${company} uw persoonsgegevens verzamelt, gebruikt, bewaart en beschermt, en welke rechten u heeft onder de AVG.`,
	},
	de: {
		eyebrow: "Rechtliches",
		title: "Datenschutzerklärung",
		updatedLabel: "Zuletzt aktualisiert:",
		date: "29. Mai 2026",
		metaTitle: `Datenschutzerklärung — ${company}`,
		metaDesc: `Wie ${company} Ihre personenbezogenen Daten erhebt, verwendet, speichert und schützt und welche Rechte Sie nach der DSGVO haben.`,
	},
} satisfies Record<Lang, unknown>;

const bodies: Record<Lang, string> = {
	en: `
<div>
	<p class="mt-0">{COMPANY} ("we", "us", "our") respects your privacy and is committed to protecting your personal data. This privacy policy explains what personal data we collect, why we collect it, the legal basis for processing it, how long we keep it, and the rights you have. It applies to visitors of our website and people who contact us.</p>
	<p>We process personal data in accordance with the EU General Data Protection Regulation (Regulation (EU) 2016/679, the "GDPR") and the Dutch GDPR Implementation Act (Uitvoeringswet Algemene verordening gegevensbescherming, "UAVG").</p>
</div>
<div>
	<h2>1. Data controller</h2>
	<p>{COMPANY} is the controller responsible for your personal data. You can reach us at:</p>
	<address class="mt-3 whitespace-pre-line not-italic text-stone-700">{COMPANY}
{ADDRESS}</address>
	<p>Email: <a href="mailto:{EMAIL}">{EMAIL}</a><br />Phone: <a href="tel:{PHONE_TEL}">{PHONE}</a></p>
</div>
<div>
	<h2>2. What personal data we collect</h2>
	<p>We only collect personal data that you provide to us voluntarily or that is strictly necessary to operate our website. Specifically:</p>
	<h3 class="mt-6">Information you give us</h3>
	<ul>
		<li><strong>Contact form data</strong> — when you use our contact form, we collect your name, email address, (optional) company name, subject and the contents of your message.</li>
		<li><strong>Correspondence</strong> — if you email or call us, we keep a record of that correspondence, including your contact details and the content of your message.</li>
	</ul>
	<h3 class="mt-6">Information collected automatically</h3>
	<ul>
		<li><strong>Anonymous usage statistics</strong> — we use Plausible Analytics to understand how our website is used. Plausible is a privacy-friendly tool that does not use cookies and does not collect any personally identifiable information. It does not track you across websites or devices. See our <a href="{COOKIES}">Cookie Policy</a> for details.</li>
	</ul>
	<p>Our content is delivered through Sanity, our content management system. Sanity does not place third-party tracking cookies or profile visitors.</p>
	<p>We do <strong>not</strong> collect special categories of personal data (such as data about health, ethnicity or political opinions), and we do not knowingly collect data from children under 16.</p>
</div>
<div>
	<h2>3. Purposes and legal bases for processing</h2>
	<p>Under the GDPR, we may only process your personal data when we have a valid legal basis. The table below sets out what we do and why.</p>
	<div class="mt-4 overflow-x-auto">
		<table class="w-full border-collapse text-left text-sm [&_td]:border-t [&_td]:border-stone-200 [&_td]:px-4 [&_td]:py-3 [&_td]:align-top [&_th]:px-4 [&_th]:py-3 [&_th]:font-semibold [&_th]:text-stone-900">
			<thead class="bg-stone-50"><tr><th>Purpose</th><th>Data used</th><th>Legal basis</th></tr></thead>
			<tbody class="text-stone-700">
				<tr><td>Responding to your enquiry</td><td>Name, email, company, message</td><td>Legitimate interest (Art. 6(1)(f)) — to answer and follow up on requests you send us</td></tr>
				<tr><td>Maintaining and securing our website</td><td>Aggregated, anonymous usage data</td><td>Legitimate interest (Art. 6(1)(f)) — to keep our website working, secure and improved</td></tr>
				<tr><td>Complying with legal obligations</td><td>Relevant correspondence and records</td><td>Legal obligation (Art. 6(1)(c)) — where the law requires us to keep records</td></tr>
			</tbody>
		</table>
	</div>
</div>
<div>
	<h2>4. How we share your data</h2>
	<p>We do not sell your personal data. We only share it where necessary:</p>
	<ul>
		<li><strong>Service providers (processors)</strong> — trusted providers who process data on our behalf and under our instructions, such as our email delivery provider (Resend) and our hosting and content infrastructure. These providers are bound by data processing agreements.</li>
		<li><strong>Authorities</strong> — where we are legally required to disclose information to competent authorities.</li>
	</ul>
	<p>Some of our service providers may process data outside the European Economic Area (EEA). Where that is the case, we ensure appropriate safeguards are in place, such as the European Commission's Standard Contractual Clauses.</p>
</div>
<div>
	<h2>5. How long we keep your data</h2>
	<p>We keep personal data only for as long as necessary for the purposes for which it was collected:</p>
	<ul>
		<li><strong>Contact enquiries</strong> — kept for up to 24 months after our last contact with you, then deleted, unless an ongoing relationship or legal obligation requires us to keep it longer.</li>
		<li><strong>Analytics data</strong> — aggregated and anonymous, so it is not linked to any identifiable individual.</li>
	</ul>
</div>
<div>
	<h2>6. Your rights</h2>
	<p>Under the GDPR, you have the following rights in relation to your personal data:</p>
	<ul>
		<li><strong>Access</strong> — request a copy of the personal data we hold about you.</li>
		<li><strong>Rectification</strong> — ask us to correct inaccurate or incomplete data.</li>
		<li><strong>Erasure</strong> — ask us to delete your data ("right to be forgotten").</li>
		<li><strong>Restriction</strong> — ask us to limit how we use your data.</li>
		<li><strong>Objection</strong> — object to processing based on our legitimate interests.</li>
		<li><strong>Data portability</strong> — receive your data in a structured, commonly used, machine-readable format.</li>
		<li><strong>Withdraw consent</strong> — where processing is based on consent, withdraw it at any time without affecting prior processing.</li>
	</ul>
	<p>To exercise any of these rights, contact us at <a href="mailto:{EMAIL}">{EMAIL}</a>. We will respond within one month. There is normally no charge.</p>
	<p>If you believe we have not handled your personal data properly, you have the right to lodge a complaint with the Dutch Data Protection Authority (Autoriteit Persoonsgegevens) at <a href="https://www.autoriteitpersoonsgegevens.nl" target="_blank" rel="noopener noreferrer">autoriteitpersoonsgegevens.nl</a>.</p>
</div>
<div>
	<h2>7. How we protect your data</h2>
	<p>We take appropriate technical and organisational measures to protect your personal data against loss, misuse and unauthorised access, including encryption in transit (HTTPS), access controls and the use of reputable, GDPR-compliant service providers.</p>
</div>
<div>
	<h2>8. Changes to this policy</h2>
	<p>We may update this privacy policy from time to time. When we do, we will revise the "last updated" date at the top of this page. We encourage you to review this page periodically.</p>
</div>
<div>
	<h2>9. Contact us</h2>
	<p>If you have any questions about this privacy policy or how we handle your personal data, please contact us:</p>
	<p>Email: <a href="mailto:{EMAIL}">{EMAIL}</a><br />Phone: <a href="tel:{PHONE_TEL}">{PHONE}</a></p>
</div>`,
	nl: `
<div>
	<p class="mt-0">{COMPANY} ("wij", "ons", "onze") respecteert uw privacy en zet zich in voor de bescherming van uw persoonsgegevens. Dit privacybeleid legt uit welke persoonsgegevens wij verzamelen, waarom wij ze verzamelen, de rechtsgrond voor de verwerking, hoe lang wij ze bewaren en welke rechten u heeft. Het geldt voor bezoekers van onze website en voor mensen die contact met ons opnemen.</p>
	<p>Wij verwerken persoonsgegevens in overeenstemming met de Algemene verordening gegevensbescherming van de EU (Verordening (EU) 2016/679, de "AVG") en de Nederlandse Uitvoeringswet Algemene verordening gegevensbescherming ("UAVG").</p>
</div>
<div>
	<h2>1. Verwerkingsverantwoordelijke</h2>
	<p>{COMPANY} is de verwerkingsverantwoordelijke voor uw persoonsgegevens. U kunt ons bereiken via:</p>
	<address class="mt-3 whitespace-pre-line not-italic text-stone-700">{COMPANY}
{ADDRESS}</address>
	<p>E-mail: <a href="mailto:{EMAIL}">{EMAIL}</a><br />Telefoon: <a href="tel:{PHONE_TEL}">{PHONE}</a></p>
</div>
<div>
	<h2>2. Welke persoonsgegevens wij verzamelen</h2>
	<p>Wij verzamelen alleen persoonsgegevens die u ons vrijwillig verstrekt of die strikt noodzakelijk zijn om onze website te laten werken. Concreet:</p>
	<h3 class="mt-6">Informatie die u ons geeft</h3>
	<ul>
		<li><strong>Gegevens uit het contactformulier</strong> — wanneer u ons contactformulier gebruikt, verzamelen wij uw naam, e-mailadres, (optioneel) bedrijfsnaam, onderwerp en de inhoud van uw bericht.</li>
		<li><strong>Correspondentie</strong> — als u ons e-mailt of belt, bewaren wij een verslag van die correspondentie, inclusief uw contactgegevens en de inhoud van uw bericht.</li>
	</ul>
	<h3 class="mt-6">Automatisch verzamelde informatie</h3>
	<ul>
		<li><strong>Anonieme gebruiksstatistieken</strong> — wij gebruiken Plausible Analytics om te begrijpen hoe onze website wordt gebruikt. Plausible is een privacyvriendelijk hulpmiddel dat geen cookies gebruikt en geen persoonlijk identificeerbare informatie verzamelt. Het volgt u niet over websites of apparaten heen. Zie ons <a href="{COOKIES}">Cookiebeleid</a> voor details.</li>
	</ul>
	<p>Onze inhoud wordt geleverd via Sanity, ons contentmanagementsysteem. Sanity plaatst geen trackingcookies van derden en profileert geen bezoekers.</p>
	<p>Wij verzamelen <strong>geen</strong> bijzondere categorieën van persoonsgegevens (zoals gegevens over gezondheid, etniciteit of politieke opvattingen), en wij verzamelen niet bewust gegevens van kinderen onder de 16 jaar.</p>
</div>
<div>
	<h2>3. Doeleinden en rechtsgronden voor de verwerking</h2>
	<p>Onder de AVG mogen wij uw persoonsgegevens alleen verwerken als wij een geldige rechtsgrond hebben. De onderstaande tabel zet uiteen wat wij doen en waarom.</p>
	<div class="mt-4 overflow-x-auto">
		<table class="w-full border-collapse text-left text-sm [&_td]:border-t [&_td]:border-stone-200 [&_td]:px-4 [&_td]:py-3 [&_td]:align-top [&_th]:px-4 [&_th]:py-3 [&_th]:font-semibold [&_th]:text-stone-900">
			<thead class="bg-stone-50"><tr><th>Doel</th><th>Gebruikte gegevens</th><th>Rechtsgrond</th></tr></thead>
			<tbody class="text-stone-700">
				<tr><td>Beantwoorden van uw verzoek</td><td>Naam, e-mail, bedrijf, bericht</td><td>Gerechtvaardigd belang (art. 6, lid 1, onder f) — om verzoeken die u ons stuurt te beantwoorden en op te volgen</td></tr>
				<tr><td>Onderhoud en beveiliging van onze website</td><td>Geaggregeerde, anonieme gebruiksgegevens</td><td>Gerechtvaardigd belang (art. 6, lid 1, onder f) — om onze website werkend, veilig en verbeterd te houden</td></tr>
				<tr><td>Voldoen aan wettelijke verplichtingen</td><td>Relevante correspondentie en administratie</td><td>Wettelijke verplichting (art. 6, lid 1, onder c) — waar de wet ons verplicht gegevens te bewaren</td></tr>
			</tbody>
		</table>
	</div>
</div>
<div>
	<h2>4. Hoe wij uw gegevens delen</h2>
	<p>Wij verkopen uw persoonsgegevens niet. Wij delen ze alleen waar dat noodzakelijk is:</p>
	<ul>
		<li><strong>Dienstverleners (verwerkers)</strong> — vertrouwde partijen die gegevens namens ons en op onze instructie verwerken, zoals onze e-mailleverancier (Resend) en onze hosting- en contentinfrastructuur. Deze partijen zijn gebonden aan verwerkersovereenkomsten.</li>
		<li><strong>Autoriteiten</strong> — waar wij wettelijk verplicht zijn informatie te verstrekken aan bevoegde autoriteiten.</li>
	</ul>
	<p>Sommige van onze dienstverleners verwerken gegevens mogelijk buiten de Europese Economische Ruimte (EER). Waar dat het geval is, zorgen wij voor passende waarborgen, zoals de modelcontractbepalingen van de Europese Commissie.</p>
</div>
<div>
	<h2>5. Hoe lang wij uw gegevens bewaren</h2>
	<p>Wij bewaren persoonsgegevens alleen zo lang als noodzakelijk is voor de doeleinden waarvoor ze zijn verzameld:</p>
	<ul>
		<li><strong>Contactverzoeken</strong> — bewaard tot 24 maanden na ons laatste contact met u, daarna verwijderd, tenzij een lopende relatie of wettelijke verplichting ons verplicht ze langer te bewaren.</li>
		<li><strong>Analysegegevens</strong> — geaggregeerd en anoniem, zodat ze niet aan een identificeerbare persoon zijn gekoppeld.</li>
	</ul>
</div>
<div>
	<h2>6. Uw rechten</h2>
	<p>Onder de AVG heeft u de volgende rechten met betrekking tot uw persoonsgegevens:</p>
	<ul>
		<li><strong>Inzage</strong> — een kopie opvragen van de persoonsgegevens die wij over u bewaren.</li>
		<li><strong>Rectificatie</strong> — ons vragen onjuiste of onvolledige gegevens te corrigeren.</li>
		<li><strong>Wissing</strong> — ons vragen uw gegevens te verwijderen ("recht op vergetelheid").</li>
		<li><strong>Beperking</strong> — ons vragen het gebruik van uw gegevens te beperken.</li>
		<li><strong>Bezwaar</strong> — bezwaar maken tegen verwerking op basis van onze gerechtvaardigde belangen.</li>
		<li><strong>Gegevensoverdraagbaarheid</strong> — uw gegevens ontvangen in een gestructureerd, gangbaar en machineleesbaar formaat.</li>
		<li><strong>Toestemming intrekken</strong> — waar de verwerking op toestemming is gebaseerd, deze op elk moment intrekken zonder dat dit eerdere verwerking aantast.</li>
	</ul>
	<p>Om een van deze rechten uit te oefenen, neemt u contact met ons op via <a href="mailto:{EMAIL}">{EMAIL}</a>. Wij reageren binnen één maand. Hier zijn normaal gesproken geen kosten aan verbonden.</p>
	<p>Als u van mening bent dat wij uw persoonsgegevens niet correct hebben behandeld, heeft u het recht een klacht in te dienen bij de Autoriteit Persoonsgegevens via <a href="https://www.autoriteitpersoonsgegevens.nl" target="_blank" rel="noopener noreferrer">autoriteitpersoonsgegevens.nl</a>.</p>
</div>
<div>
	<h2>7. Hoe wij uw gegevens beschermen</h2>
	<p>Wij nemen passende technische en organisatorische maatregelen om uw persoonsgegevens te beschermen tegen verlies, misbruik en ongeoorloofde toegang, waaronder versleuteling tijdens verzending (HTTPS), toegangscontroles en het gebruik van betrouwbare, AVG-conforme dienstverleners.</p>
</div>
<div>
	<h2>8. Wijzigingen in dit beleid</h2>
	<p>Wij kunnen dit privacybeleid van tijd tot tijd bijwerken. Wanneer wij dat doen, passen wij de datum "laatst bijgewerkt" bovenaan deze pagina aan. Wij raden u aan deze pagina regelmatig te bekijken.</p>
</div>
<div>
	<h2>9. Contact</h2>
	<p>Als u vragen heeft over dit privacybeleid of over hoe wij met uw persoonsgegevens omgaan, neem dan contact met ons op:</p>
	<p>E-mail: <a href="mailto:{EMAIL}">{EMAIL}</a><br />Telefoon: <a href="tel:{PHONE_TEL}">{PHONE}</a></p>
</div>`,
	de: `
<div>
	<p class="mt-0">{COMPANY} ("wir", "uns", "unser") respektiert Ihre Privatsphäre und setzt sich für den Schutz Ihrer personenbezogenen Daten ein. Diese Datenschutzerklärung erläutert, welche personenbezogenen Daten wir erheben, warum wir sie erheben, die Rechtsgrundlage für die Verarbeitung, wie lange wir sie aufbewahren und welche Rechte Sie haben. Sie gilt für Besucher unserer Website und für Personen, die uns kontaktieren.</p>
	<p>Wir verarbeiten personenbezogene Daten im Einklang mit der Datenschutz-Grundverordnung der EU (Verordnung (EU) 2016/679, die "DSGVO") und dem niederländischen DSGVO-Ausführungsgesetz (Uitvoeringswet Algemene verordening gegevensbescherming, "UAVG").</p>
</div>
<div>
	<h2>1. Verantwortlicher</h2>
	<p>{COMPANY} ist der für Ihre personenbezogenen Daten verantwortliche Verantwortliche. Sie erreichen uns unter:</p>
	<address class="mt-3 whitespace-pre-line not-italic text-stone-700">{COMPANY}
{ADDRESS}</address>
	<p>E-Mail: <a href="mailto:{EMAIL}">{EMAIL}</a><br />Telefon: <a href="tel:{PHONE_TEL}">{PHONE}</a></p>
</div>
<div>
	<h2>2. Welche personenbezogenen Daten wir erheben</h2>
	<p>Wir erheben nur personenbezogene Daten, die Sie uns freiwillig zur Verfügung stellen oder die für den Betrieb unserer Website unbedingt erforderlich sind. Im Einzelnen:</p>
	<h3 class="mt-6">Informationen, die Sie uns geben</h3>
	<ul>
		<li><strong>Daten aus dem Kontaktformular</strong> — wenn Sie unser Kontaktformular nutzen, erheben wir Ihren Namen, Ihre E-Mail-Adresse, (optional) den Firmennamen, den Betreff und den Inhalt Ihrer Nachricht.</li>
		<li><strong>Korrespondenz</strong> — wenn Sie uns per E-Mail oder Telefon kontaktieren, bewahren wir eine Aufzeichnung dieser Korrespondenz auf, einschließlich Ihrer Kontaktdaten und des Inhalts Ihrer Nachricht.</li>
	</ul>
	<h3 class="mt-6">Automatisch erhobene Informationen</h3>
	<ul>
		<li><strong>Anonyme Nutzungsstatistiken</strong> — wir verwenden Plausible Analytics, um zu verstehen, wie unsere Website genutzt wird. Plausible ist ein datenschutzfreundliches Tool, das keine Cookies verwendet und keine personenbezogenen Daten erhebt. Es verfolgt Sie nicht über Websites oder Geräte hinweg. Einzelheiten finden Sie in unserer <a href="{COOKIES}">Cookie-Richtlinie</a>.</li>
	</ul>
	<p>Unsere Inhalte werden über Sanity, unser Content-Management-System, bereitgestellt. Sanity setzt keine Tracking-Cookies von Drittanbietern und erstellt keine Profile von Besuchern.</p>
	<p>Wir erheben <strong>keine</strong> besonderen Kategorien personenbezogener Daten (etwa Daten über Gesundheit, ethnische Herkunft oder politische Meinungen) und erheben nicht wissentlich Daten von Kindern unter 16 Jahren.</p>
</div>
<div>
	<h2>3. Zwecke und Rechtsgrundlagen der Verarbeitung</h2>
	<p>Nach der DSGVO dürfen wir Ihre personenbezogenen Daten nur verarbeiten, wenn wir eine gültige Rechtsgrundlage haben. Die folgende Tabelle legt dar, was wir tun und warum.</p>
	<div class="mt-4 overflow-x-auto">
		<table class="w-full border-collapse text-left text-sm [&_td]:border-t [&_td]:border-stone-200 [&_td]:px-4 [&_td]:py-3 [&_td]:align-top [&_th]:px-4 [&_th]:py-3 [&_th]:font-semibold [&_th]:text-stone-900">
			<thead class="bg-stone-50"><tr><th>Zweck</th><th>Verwendete Daten</th><th>Rechtsgrundlage</th></tr></thead>
			<tbody class="text-stone-700">
				<tr><td>Beantwortung Ihrer Anfrage</td><td>Name, E-Mail, Unternehmen, Nachricht</td><td>Berechtigtes Interesse (Art. 6 Abs. 1 lit. f) — um Anfragen, die Sie uns senden, zu beantworten und nachzuverfolgen</td></tr>
				<tr><td>Betrieb und Sicherung unserer Website</td><td>Aggregierte, anonyme Nutzungsdaten</td><td>Berechtigtes Interesse (Art. 6 Abs. 1 lit. f) — um unsere Website funktionsfähig, sicher und verbessert zu halten</td></tr>
				<tr><td>Erfüllung gesetzlicher Pflichten</td><td>Relevante Korrespondenz und Aufzeichnungen</td><td>Rechtliche Verpflichtung (Art. 6 Abs. 1 lit. c) — sofern das Gesetz uns zur Aufbewahrung verpflichtet</td></tr>
			</tbody>
		</table>
	</div>
</div>
<div>
	<h2>4. Wie wir Ihre Daten weitergeben</h2>
	<p>Wir verkaufen Ihre personenbezogenen Daten nicht. Wir geben sie nur weiter, wo es erforderlich ist:</p>
	<ul>
		<li><strong>Dienstleister (Auftragsverarbeiter)</strong> — vertrauenswürdige Anbieter, die Daten in unserem Auftrag und nach unseren Weisungen verarbeiten, etwa unser E-Mail-Zustelldienst (Resend) sowie unsere Hosting- und Content-Infrastruktur. Diese Anbieter sind durch Auftragsverarbeitungsverträge gebunden.</li>
		<li><strong>Behörden</strong> — sofern wir gesetzlich verpflichtet sind, Informationen an zuständige Behörden offenzulegen.</li>
	</ul>
	<p>Einige unserer Dienstleister verarbeiten Daten möglicherweise außerhalb des Europäischen Wirtschaftsraums (EWR). In diesem Fall stellen wir geeignete Garantien sicher, etwa die Standardvertragsklauseln der Europäischen Kommission.</p>
</div>
<div>
	<h2>5. Wie lange wir Ihre Daten aufbewahren</h2>
	<p>Wir bewahren personenbezogene Daten nur so lange auf, wie es für die Zwecke, für die sie erhoben wurden, erforderlich ist:</p>
	<ul>
		<li><strong>Kontaktanfragen</strong> — bis zu 24 Monate nach unserem letzten Kontakt mit Ihnen aufbewahrt, danach gelöscht, es sei denn, eine laufende Beziehung oder gesetzliche Verpflichtung erfordert eine längere Aufbewahrung.</li>
		<li><strong>Analysedaten</strong> — aggregiert und anonym, sodass sie keiner identifizierbaren Person zugeordnet sind.</li>
	</ul>
</div>
<div>
	<h2>6. Ihre Rechte</h2>
	<p>Nach der DSGVO haben Sie in Bezug auf Ihre personenbezogenen Daten die folgenden Rechte:</p>
	<ul>
		<li><strong>Auskunft</strong> — eine Kopie der über Sie gespeicherten personenbezogenen Daten anfordern.</li>
		<li><strong>Berichtigung</strong> — uns bitten, unrichtige oder unvollständige Daten zu korrigieren.</li>
		<li><strong>Löschung</strong> — uns bitten, Ihre Daten zu löschen ("Recht auf Vergessenwerden").</li>
		<li><strong>Einschränkung</strong> — uns bitten, die Nutzung Ihrer Daten einzuschränken.</li>
		<li><strong>Widerspruch</strong> — der Verarbeitung auf Grundlage unserer berechtigten Interessen widersprechen.</li>
		<li><strong>Datenübertragbarkeit</strong> — Ihre Daten in einem strukturierten, gängigen und maschinenlesbaren Format erhalten.</li>
		<li><strong>Widerruf der Einwilligung</strong> — sofern die Verarbeitung auf einer Einwilligung beruht, diese jederzeit widerrufen, ohne dass die bisherige Verarbeitung berührt wird.</li>
	</ul>
	<p>Um eines dieser Rechte auszuüben, kontaktieren Sie uns unter <a href="mailto:{EMAIL}">{EMAIL}</a>. Wir antworten innerhalb eines Monats. In der Regel entstehen keine Kosten.</p>
	<p>Wenn Sie der Ansicht sind, dass wir Ihre personenbezogenen Daten nicht ordnungsgemäß behandelt haben, haben Sie das Recht, eine Beschwerde bei der niederländischen Datenschutzbehörde (Autoriteit Persoonsgegevens) unter <a href="https://www.autoriteitpersoonsgegevens.nl" target="_blank" rel="noopener noreferrer">autoriteitpersoonsgegevens.nl</a> einzureichen.</p>
</div>
<div>
	<h2>7. Wie wir Ihre Daten schützen</h2>
	<p>Wir treffen geeignete technische und organisatorische Maßnahmen, um Ihre personenbezogenen Daten vor Verlust, Missbrauch und unbefugtem Zugriff zu schützen, einschließlich Verschlüsselung bei der Übertragung (HTTPS), Zugriffskontrollen und der Nutzung angesehener, DSGVO-konformer Dienstleister.</p>
</div>
<div>
	<h2>8. Änderungen dieser Erklärung</h2>
	<p>Wir können diese Datenschutzerklärung von Zeit zu Zeit aktualisieren. Wenn wir das tun, aktualisieren wir das Datum "zuletzt aktualisiert" oben auf dieser Seite. Wir empfehlen Ihnen, diese Seite regelmäßig zu überprüfen.</p>
</div>
<div>
	<h2>9. Kontakt</h2>
	<p>Wenn Sie Fragen zu dieser Datenschutzerklärung oder zum Umgang mit Ihren personenbezogenen Daten haben, kontaktieren Sie uns bitte:</p>
	<p>E-Mail: <a href="mailto:{EMAIL}">{EMAIL}</a><br />Telefon: <a href="tel:{PHONE_TEL}">{PHONE}</a></p>
</div>`,
};

const m = meta[lang];
const body = bodies[lang]
	.replaceAll("{COMPANY}", company)
	.replaceAll("{EMAIL}", email)
	.replaceAll("{PHONE_TEL}", telHref)
	.replaceAll("{PHONE}", phone)
	.replaceAll("{ADDRESS}", address)
	.replaceAll("{COOKIES}", cookiesHref);
---

<BaseLayout title={m.metaTitle} description={m.metaDesc}>
	<!-- Hero -->
	<section class="bg-stone-50">
		<div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 lg:px-8">
			<p class="text-sm font-semibold uppercase tracking-wider text-brand-600">
				{m.eyebrow}
			</p>
			<h1 class="mt-3 text-4xl font-extrabold tracking-tight text-stone-900 sm:text-5xl">
				{m.title}
			</h1>
			<p class="mt-4 text-base text-stone-500">
				{m.updatedLabel} {m.date}
			</p>
		</div>
	</section>

	<!-- Body -->
	<section class="bg-white">
		<div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
			<article
				class="space-y-10 text-base leading-relaxed text-stone-700
					[&_h2]:mt-2 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:tracking-tight [&_h2]:text-stone-900
					[&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-stone-900
					[&_p]:mt-3
					[&_ul]:mt-3 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-6
					[&_a]:font-medium [&_a]:text-brand-600 [&_a:hover]:underline"
				set:html={body}
			/>
		</div>
	</section>
</BaseLayout>
