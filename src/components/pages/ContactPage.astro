---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactForm from "../ContactForm.tsx";
import { getSiteSettings } from "../../lib/sanity";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// --- Data fetching ------------------------------------------------------
// Pull contact details from Sanity site settings, with safe fallbacks.
const settings = (await getSiteSettings()) ?? {};

const email: string = settings.email ?? "jan@kuijperskip.com";
const phone: string = settings.phone ?? "+31 (0)6 28427410";
const address: string =
	settings.address ??
	"Witveldweg 35\nGrubbenvorst\nThe Netherlands";

const tel = phone.replace(/[^+\d]/g, "");

// Build a keyless Google Maps embed URL from the address (newlines -> commas).
const mapQuery = encodeURIComponent(address.replace(/\n+/g, ", "));
const mapSrc = `https://www.google.com/maps?q=${mapQuery}&output=embed`;

const details = [
	{
		label: t("contact.info.email"),
		value: email,
		href: `mailto:${email}`,
		icon: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
	},
	{
		label: t("contact.info.phone"),
		value: phone,
		href: `tel:${tel}`,
		icon: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>',
	},
	{
		label: t("contact.info.address"),
		value: address,
		href: null,
		icon: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
	},
];
---

<BaseLayout
	title={t("contact.meta.title")}
	description={t("contact.meta.desc")}
>
	<!-- 1. Hero -->
	<section class="hero-full relative overflow-hidden bg-stone-900">
		<!-- Full-bleed background photograph -->
		<img
			src="/images/contact-hero.jpg"
			alt=""
			aria-hidden="true"
			class="absolute inset-0 h-full w-full object-cover object-bottom"
			loading="eager"
		/>
		<!-- Cinematic dark overlay for legibility -->
		<div
			class="absolute inset-0 bg-gradient-to-b from-stone-950/75 via-stone-950/60 to-stone-950/80"
		>
		</div>
		<div
			class="relative mx-auto max-w-7xl px-4 py-28 sm:px-6 sm:py-32 lg:px-8"
		>
			<div class="mx-auto max-w-3xl text-center">
				<span
					class="text-sm font-semibold uppercase tracking-[0.15em] text-brand-300"
				>
					{t("contact.hero.eyebrow")}
				</span>
				<h1
					class="mt-5 text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl"
				>
					{t("contact.hero.titleA")}<span class="text-brand-300">{t("contact.hero.titleHl")}</span>{t("contact.hero.titleB")}
				</h1>
				<p
					class="mx-auto mt-6 max-w-[580px] text-lg leading-[1.65] text-stone-200"
				>
					{t("contact.hero.subtitle")}
				</p>

				<!-- Contact options strip -->
				<div
					class="mt-8 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-base font-semibold"
				>
					<a
						href={`mailto:${email}`}
						class="text-brand-300 transition-colors hover:text-white"
					>
						{t("contact.hero.emailUs")}
					</a>
					<span class="text-stone-500" aria-hidden="true">·</span>
					<a
						href={`https://www.google.com/maps?q=${mapQuery}`}
						target="_blank"
						rel="noopener noreferrer"
						class="text-brand-300 transition-colors hover:text-white"
					>
						{t("contact.hero.visit")}
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- 2. Form + contact info -->
	<section class="bg-white">
		<div class="mx-auto max-w-7xl px-4 pt-20 pb-24 sm:px-6 lg:px-8 lg:pt-28">
			<div class="grid grid-cols-1 gap-12 lg:grid-cols-5 lg:gap-16">
				<!-- Left: form (interactive React island) -->
				<div class="lg:col-span-3">
					<div
						class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8"
					>
						<h2 class="text-2xl font-bold tracking-tight text-stone-900">
							{t("contact.form.heading")}
						</h2>
						<p class="mt-2 text-base text-stone-600">
							{t("contact.form.sub")}
						</p>
						<div class="mt-6">
							<ContactForm client:load lang={lang} />
						</div>
						<p class="mt-4 text-sm italic text-stone-500">
							{t("contact.form.reply")}
						</p>
					</div>
				</div>

				<!-- Right: contact info -->
				<div class="lg:col-span-2">
					<h2 class="text-2xl font-bold tracking-tight text-stone-900">
						{t("contact.info.heading")}
					</h2>
					<p class="mt-2 text-base text-stone-600">
						{t("contact.info.sub")}
					</p>

					<ul class="mt-8 space-y-6">
						{
							details.map((item) => (
								<li class="flex gap-4">
									<div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
										<svg
											class="h-5 w-5"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
											aria-hidden="true"
											set:html={item.icon}
										/>
									</div>
									<div>
										<p class="text-sm font-semibold uppercase tracking-wider text-stone-500">
											{item.label}
										</p>
										{item.href ? (
											<a
												href={item.href}
												class="mt-1 block text-base text-stone-800 transition-colors hover:text-brand-600"
											>
												{item.value}
											</a>
										) : (
											<p class="mt-1 whitespace-pre-line text-base text-stone-800">
												{item.value}
											</p>
										)}
									</div>
								</li>
							))
						}
					</ul>

					<!-- Map -->
					<div
						class="mt-8 aspect-[4/3] w-full overflow-hidden rounded-xl border border-stone-200 bg-stone-100"
					>
						<iframe
							src={mapSrc}
							title="Map showing the location of Kuijpers Kip Research Field"
							class="h-full w-full border-0"
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
					</div>
				</div>
			</div>

			<!-- Closing signature -->
			<p class="mt-16 text-center text-base italic text-brand-600">
				{t("contact.team")}
			</p>
		</div>
	</section>
</BaseLayout>
