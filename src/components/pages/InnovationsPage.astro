---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InnovationExplorer from "../innovations/InnovationExplorer.tsx";
import FarmView3D from "../innovations/FarmView3D.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout
	title={t("inn.meta.title")}
	description={t("inn.meta.desc")}
>
	<!-- 1. Hero -->
	<section class="relative overflow-hidden bg-stone-900">
		<!-- Full-bleed background photograph -->
		<img
			src="/images/innovations-hero.jpg"
			alt=""
			aria-hidden="true"
			class="absolute inset-0 h-full w-full object-cover"
			loading="eager"
		/>
		<!-- Cinematic dark overlay for legibility -->
		<div
			class="absolute inset-0 bg-gradient-to-b from-stone-950/70 via-stone-950/55 to-stone-950/75"
		>
		</div>
		<div
			class="relative mx-auto max-w-7xl px-4 py-28 sm:px-6 sm:py-32 lg:px-8"
		>
			<div class="mx-auto max-w-3xl text-center">
				<h1
					class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl"
				>
					{t("inn.hero.titleA")}<span class="whitespace-nowrap text-brand-300">{t("inn.hero.titleHl")}</span>
				</h1>
				<p
					class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-stone-200 sm:text-xl"
				>
					{t("inn.hero.subtitle")}
				</p>
			</div>
		</div>
	</section>

	<!-- 2. Explore the site — 3D farm model -->
	<FarmView3D />

	<!-- 3. Interactive innovation explorer -->
	<section class="bg-white">
		<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
			<div class="mx-auto mb-12 max-w-3xl text-center">
				<span
					class="text-sm font-semibold uppercase tracking-[0.15em] text-brand-600"
				>
					{t("inn.section.eyebrow")}
				</span>
				<h2
					class="mt-5 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl"
				>
					{t("inn.section.title")}
				</h2>
				<p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-stone-600">
					{t("inn.section.subtitle")}
				</p>
			</div>

			<InnovationExplorer client:visible lang={lang} />
		</div>
	</section>
</BaseLayout>
