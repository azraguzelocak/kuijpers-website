---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllNews } from "../../lib/sanity";
import { urlFor } from "../../lib/image";

// --- Data fetching ------------------------------------------------------
const posts = (await getAllNews()) ?? [];

const PER_PAGE = 9;
const totalPages = Math.ceil(posts.length / PER_PAGE);

// --- Helpers ------------------------------------------------------------
const fmtDate = (d?: string) =>
	d
		? new Date(d).toLocaleDateString("en-GB", {
				year: "numeric",
				month: "long",
				day: "numeric",
			})
		: null;
---

<BaseLayout
	title="News & Updates — Kuijpers Kip Research Field"
	description="The latest news, announcements and updates from the Kuijpers Kip Research Field."
>
	<!-- 1. Hero -->
	<section class="bg-stone-50">
		<div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-3xl text-center">
				<h1
					class="text-4xl font-extrabold tracking-tight text-stone-900 sm:text-5xl lg:text-6xl"
				>
					News &amp; <span class="text-brand-600">Updates</span>
				</h1>
				<p
					class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-stone-600 sm:text-xl"
				>
					Announcements, milestones and stories from the research
					field. Stay up to date with what we're learning and
					building.
				</p>
			</div>
		</div>
	</section>

	<!-- 2. Post grid -->
	<section class="bg-white">
		<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
			{
				posts.length > 0 ? (
					<>
						<div
							id="news-grid"
							class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3"
						>
							{posts.map((post: any, i: number) => (
								<article
									class:list={[
										"news-card group flex flex-col overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm transition-shadow hover:shadow-md",
										{ hidden: i >= PER_PAGE },
									]}
									data-index={i}
								>
									<a
										href={`/news/${post.slug}`}
										class="flex flex-1 flex-col"
									>
										{/* Hero image */}
										<div class="relative aspect-[16/9] w-full overflow-hidden bg-gradient-to-br from-brand-100 to-brand-50">
											{post.mainImage ? (
												<img
													src={urlFor(post.mainImage)
														.width(800)
														.height(450)
														.fit("crop")
														.url()}
													alt={
														post.mainImage.alt ??
														post.title
													}
													width="800"
													height="450"
													class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
													loading="lazy"
												/>
											) : (
												<div class="flex h-full w-full items-center justify-center">
													<span class="text-sm font-medium text-brand-400">
														Kuijpers Kip Research Field
													</span>
												</div>
											)}
										</div>

										{/* Body */}
										<div class="flex flex-1 flex-col p-6">
											{post.publishedAt && (
												<time
													datetime={post.publishedAt}
													class="text-sm text-stone-500"
												>
													{fmtDate(post.publishedAt)}
												</time>
											)}
											<h2 class="mt-2 text-xl font-semibold text-stone-900 group-hover:text-brand-700">
												{post.title}
											</h2>
											{post.excerpt && (
												<p class="mt-3 line-clamp-3 flex-1 text-base leading-relaxed text-stone-600">
													{post.excerpt}
												</p>
											)}
											<span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-600">
												Read more
												<svg
													class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
													viewBox="0 0 24 24"
													fill="none"
													stroke="currentColor"
													stroke-width="2"
													stroke-linecap="round"
													stroke-linejoin="round"
													aria-hidden="true"
												>
													<path d="M5 12h14" />
													<path d="m12 5 7 7-7 7" />
												</svg>
											</span>
										</div>
									</a>
								</article>
							))}
						</div>

						{/* Pagination — only shown when there is more than one page */}
						{totalPages > 1 && (
							<nav
								id="pagination"
								class="mt-12 flex items-center justify-center gap-2"
								aria-label="Pagination"
							>
								<button
									type="button"
									id="page-prev"
									class="rounded-lg border border-stone-200 px-3 py-2 text-sm font-semibold text-stone-600 transition-colors hover:bg-stone-50 disabled:cursor-not-allowed disabled:opacity-40"
									aria-label="Previous page"
								>
									Prev
								</button>
								<div
									id="page-numbers"
									class="flex items-center gap-1"
								>
									{Array.from(
										{ length: totalPages },
										(_, p) => (
											<button
												type="button"
												class="page-num h-9 w-9 rounded-lg border border-stone-200 text-sm font-semibold text-stone-600 transition-colors hover:bg-stone-50 aria-[current=page]:border-brand-600 aria-[current=page]:bg-brand-600 aria-[current=page]:text-white"
												data-page={p}
												aria-current={
													p === 0 ? "page" : undefined
												}
											>
												{p + 1}
											</button>
										),
									)}
								</div>
								<button
									type="button"
									id="page-next"
									class="rounded-lg border border-stone-200 px-3 py-2 text-sm font-semibold text-stone-600 transition-colors hover:bg-stone-50 disabled:cursor-not-allowed disabled:opacity-40"
									aria-label="Next page"
								>
									Next
								</button>
							</nav>
						)}
					</>
				) : (
					<p class="text-center text-stone-500">
						No news yet — check back soon for updates.
					</p>
				)
			}
		</div>
	</section>
</BaseLayout>

<script define:vars={{ PER_PAGE, totalPages }}>
	// --- Client-side pagination ------------------------------------------
	// All cards are rendered server-side; we simply toggle visibility 9 at a
	// time so the page works without a network round-trip per page.
	if (totalPages > 1) {
		const cards = Array.from(document.querySelectorAll(".news-card"));
		const numbers = Array.from(document.querySelectorAll(".page-num"));
		const prev = document.getElementById("page-prev");
		const next = document.getElementById("page-next");
		let current = 0;

		function render() {
			const start = current * PER_PAGE;
			const end = start + PER_PAGE;
			cards.forEach((card, i) => {
				card.classList.toggle("hidden", i < start || i >= end);
			});
			numbers.forEach((btn) => {
				const p = Number(btn.dataset.page);
				if (p === current) btn.setAttribute("aria-current", "page");
				else btn.removeAttribute("aria-current");
			});
			if (prev) prev.disabled = current === 0;
			if (next) next.disabled = current === totalPages - 1;
			window.scrollTo({ top: 0, behavior: "smooth" });
		}

		numbers.forEach((btn) => {
			btn.addEventListener("click", () => {
				current = Number(btn.dataset.page);
				render();
			});
		});
		prev?.addEventListener("click", () => {
			if (current > 0) {
				current--;
				render();
			}
		});
		next?.addEventListener("click", () => {
			if (current < totalPages - 1) {
				current++;
				render();
			}
		});
	}
</script>
