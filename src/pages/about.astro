---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAllTeamMembers } from "../lib/sanity";
import { urlFor } from "../lib/image";

// --- Data fetching ------------------------------------------------------
const team = (await getAllTeamMembers()) ?? [];

// --- Mission / Vision / Values -----------------------------------------
// Inner SVG markup rendered inside a <svg fill="none" stroke="currentColor">
// wrapper below (Lucide-style, matching the icon approach on the homepage).
const pillars = [
	{
		title: "Our Mission",
		tagline: "Turning data into decisions the whole chain can trust.",
		body: "We advance animal welfare, production efficiency, and environmental sustainability by transforming real-time data from the poultry chain into validated, actionable insight — insight that producers, suppliers, and policymakers can act on with confidence.",
	},
	{
		title: "Our Vision",
		tagline: "Every intervention proven before it reaches the barn.",
		body: "A food system where decisions are no longer made on assumption. Where every new feed, technology, or practice is tested in a controlled, data-rich environment first — making innovation faster, safer, and grounded in evidence the entire sector can rely on.",
	},
	{
		title: "Our Values",
		tagline: "Rigour. Transparency. Partnership.",
		body: "We hold ourselves to the standards of independent science: we publish what we learn, validate our findings openly, and protect the integrity of our methods. We work shoulder to shoulder with researchers, suppliers, and producers — because real progress in poultry production is built on trust, not promises.",
	},
];
---

<BaseLayout
	title="About — Kuijpers Research Field"
	description="Learn about Kuijpers Research Field: our mission, vision, values, story and the team behind digital twin technology for poultry production."
>
	<!-- 1. Hero -->
	<section class="relative overflow-hidden bg-stone-900">
		<!-- Full-bleed background photograph -->
		<img
			src="/images/about-hero.jpg"
			alt=""
			aria-hidden="true"
			class="absolute inset-0 h-full w-full object-cover"
			loading="eager"
		/>
		<!-- Cinematic dark overlay for legibility -->
		<div
			class="absolute inset-0 bg-gradient-to-b from-stone-950/55 via-stone-950/40 to-stone-950/60"
		>
		</div>
		<div
			class="relative mx-auto max-w-7xl px-4 py-28 sm:px-6 sm:py-32 lg:px-8"
		>
			<div class="mx-auto max-w-3xl text-center">
				<h1
					class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl"
				>
					Kuijpers Research Field
				</h1>
				<p
					class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-stone-200 sm:text-xl"
				>
					<span class="font-semibold text-brand-300 sm:text-2xl"
						>Science moves carefully. Industry moves fast.</span
					>{" "}
					The space between them is where most progress in poultry
					production gets lost.
				</p>
				<p
					class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-stone-300 sm:text-lg"
				>
					Kuijpers Research Field exists in that space. We build digital
					twins of the broiler value chain — virtual replicas grounded in
					real-time data — that give researchers, suppliers, and producers
					a shared environment where evidence is generated quickly,
					rigorously, and at commercial scale.
				</p>
			</div>
		</div>
	</section>

	<!-- 2. Mission / Vision / Values -->
	<section class="bg-white">
		<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
			<div
				class="grid grid-cols-1 gap-8 md:grid-cols-3"
			>
				{
					pillars.map((pillar) => (
						<div class="flex flex-col rounded-xl border border-stone-200 bg-white p-8 shadow-sm">
							<h2 class="text-xl font-semibold text-stone-900">
								{pillar.title}
							</h2>
							<p class="mt-3 text-base font-semibold leading-snug text-brand-700">
								{pillar.tagline}
							</p>
							<p class="mt-3 text-base leading-relaxed text-stone-600">
								{pillar.body}
							</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- 3. Our story -->
	<section class="bg-stone-50">
		<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
			<div
				class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2"
			>
				<div class="border-l-2 border-brand-600 pl-6 sm:pl-8">
					<span
						class="text-sm font-semibold uppercase tracking-wider text-brand-600"
					>
						Our Story
					</span>
					<h2
						class="mt-4 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl"
					>
						From the family farm to a research field
					</h2>
					<p class="mt-6 text-base leading-[1.65] text-stone-600">
						Kuijpers Research Field grew out of generations of
						hands-on poultry expertise. Working day to day with
						producers, we kept running into the same question: how do
						you know whether a new feed, climate setting, or housing
						approach will actually work — before committing an entire
						flock to it?
					</p>
					<p class="mt-3 text-base leading-snug text-stone-600">
						Trial and error in a live barn is slow, costly, and
						difficult to measure. So we built a different kind of barn.
					</p>
					<p class="mt-5 text-base leading-[1.65] text-stone-600">
						Today, our facility is a fully instrumented, sensor-rich
						research environment paired with a digital twin that mirrors
						it in real time. We partner with universities, suppliers, and
						producers to validate interventions independently, publish
						what we learn, and help the sector make decisions that improve
						welfare, reduce environmental impact, and strengthen the
						entire broiler value chain.
					</p>

					<!-- Fact strip -->
					<div
						class="mt-8 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm font-medium text-stone-500"
					>
						<span>Founded by the Kuijpers family</span>
						<span class="text-stone-300" aria-hidden="true">·</span>
						<span>Based in the Netherlands</span>
						<span class="text-stone-300" aria-hidden="true">·</span>
						<span>Independent research partner</span>
					</div>
				</div>
				<div class="overflow-hidden rounded-xl bg-stone-200 shadow-sm">
					<img
						src="/images/our-story-family.png"
						alt="The Kuijpers family, founders of Kuijpers Research Field"
						width="800"
						height="600"
						class="aspect-[4/3] w-full object-cover"
						loading="lazy"
					/>
				</div>
			</div>
		</div>
	</section>

	<!-- 4. Team -->
	<section class="bg-white">
		<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-2xl text-center">
				<span
					class="text-sm font-semibold uppercase tracking-wider text-brand-600"
				>
					Our People
				</span>
				<h2
					class="mt-4 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl"
				>
					Meet the team
				</h2>
			</div>

			{
				team.length > 0 ? (
					<div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
						{team.map((member: any) => (
							<div class="flex flex-col overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm transition-shadow hover:shadow-md">
								{member.photo ? (
									<img
										src={urlFor(member.photo)
											.width(500)
											.height(500)
											.fit("crop")
											.url()}
										alt={member.name}
										width="500"
										height="500"
										class="aspect-square w-full object-cover"
										loading="lazy"
									/>
								) : (
									<div class="flex aspect-square w-full items-center justify-center bg-gradient-to-br from-brand-100 to-brand-50">
										<span class="text-3xl font-bold text-brand-400">
											{(member.name ?? "?")
												.charAt(0)
												.toUpperCase()}
										</span>
									</div>
								)}
								<div class="flex flex-1 flex-col p-5">
									<h3 class="text-lg font-semibold text-stone-900">
										{member.name}
									</h3>
									<p class="mt-1 flex-1 text-sm text-stone-600">
										{member.role}
									</p>
									{member.linkedin && (
										<a
											href={member.linkedin}
											target="_blank"
											rel="noopener noreferrer"
											aria-label={`${member.name} on LinkedIn`}
											class="mt-4 inline-flex h-9 w-9 items-center justify-center rounded-lg bg-stone-100 text-stone-500 transition-colors hover:bg-brand-50 hover:text-brand-600"
										>
											<svg
												class="h-5 w-5"
												viewBox="0 0 24 24"
												fill="currentColor"
												aria-hidden="true"
											>
												<path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" />
											</svg>
										</a>
									)}
								</div>
							</div>
						))}
					</div>
				) : (
					<p class="mt-12 text-center text-stone-500">
						Team profiles are coming soon — check back shortly.
					</p>
				)
			}
		</div>
	</section>

	<!-- 5. Partners -->
	<section class="bg-stone-50">
		<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
			<p
				class="text-center text-sm font-semibold uppercase tracking-wider text-stone-500"
			>
				Our Partners
			</p>
			<div
				class="mt-8 grid grid-cols-2 items-center gap-6 sm:grid-cols-3 lg:grid-cols-5"
			>
				{
					Array.from({ length: 5 }).map(() => (
						<div class="flex h-16 items-center justify-center rounded-lg bg-white shadow-sm">
							<span class="text-xs font-medium uppercase tracking-wider text-stone-400">
								Logo
							</span>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- 6. CTA -->
	<section class="bg-brand-800">
		<div class="mx-auto max-w-7xl px-4 py-20 text-center sm:px-6 lg:px-8">
			<h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
				Let's build something together
			</h2>
			<p
				class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-brand-100"
			>
				Curious how digital twin technology could support your research,
				products or production? We'd love to hear from you.
			</p>
			<div class="mt-10">
				<a
					href="/contact"
					class="inline-block rounded-lg bg-white px-8 py-3 text-base font-semibold text-brand-800 shadow-sm transition-colors hover:bg-stone-100"
				>
					Get in Touch
				</a>
			</div>
		</div>
	</section>
</BaseLayout>
