---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAllTeamMembers } from "../lib/sanity";
import { urlFor } from "../lib/image";

// --- Data fetching ------------------------------------------------------
const team = (await getAllTeamMembers()) ?? [];

// --- Mission / Vision / Values -----------------------------------------
// Inner SVG markup rendered inside a <svg fill="none" stroke="currentColor">
// wrapper below (Lucide-style, matching the icon approach on the homepage).
const pillars = [
	{
		title: "Our Mission",
		icon: '<path d="M12 2v4"/><path d="M12 18v4"/><path d="M4.93 4.93l2.83 2.83"/><path d="M16.24 16.24l2.83 2.83"/><path d="M2 12h4"/><path d="M18 12h4"/><path d="M4.93 19.07l2.83-2.83"/><path d="M16.24 7.76l2.83-2.83"/>',
		body: "To advance animal welfare, efficiency and sustainability in poultry production by turning real-time data into validated, actionable insight that the whole value chain can trust.",
	},
	{
		title: "Our Vision",
		icon: '<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>',
		body: "A food system where every intervention is tested in a controlled, data-rich environment before it reaches the barn — making decisions faster, safer and grounded in evidence.",
	},
	{
		title: "Our Values",
		icon: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>',
		body: "Scientific rigour, transparency and partnership. We publish what we learn, validate independently, and work shoulder to shoulder with researchers, suppliers and producers.",
	},
];
---

<BaseLayout
	title="About — Kuijpers Research Field"
	description="Learn about Kuijpers Research Field: our mission, vision, values, story and the team behind digital twin technology for poultry production."
>
	<!-- 1. Hero -->
	<section class="bg-stone-50">
		<div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-3xl text-center">
				<h1
					class="text-4xl font-extrabold tracking-tight text-stone-900 sm:text-5xl lg:text-6xl"
				>
					About Kuijpers Research Field
				</h1>
				<p
					class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-stone-600 sm:text-xl"
				>
					We build virtual replicas of poultry production systems —
					digital twins — that let researchers, suppliers and producers
					test ideas in a controlled, data-rich environment. Our work
					sits at the meeting point of science and practice, advancing
					welfare, efficiency and sustainability across the broiler
					value chain.
				</p>
			</div>
		</div>
	</section>

	<!-- 2. Mission / Vision / Values -->
	<section class="bg-white">
		<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
			<div
				class="grid grid-cols-1 gap-8 md:grid-cols-3"
			>
				{
					pillars.map((pillar) => (
						<div class="flex flex-col rounded-xl border border-stone-200 bg-white p-8 shadow-sm">
							<div class="flex h-12 w-12 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
								<svg
									class="h-6 w-6"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
									set:html={pillar.icon}
								/>
							</div>
							<h2 class="mt-5 text-xl font-semibold text-stone-900">
								{pillar.title}
							</h2>
							<p class="mt-3 text-base leading-relaxed text-stone-600">
								{pillar.body}
							</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- 3. Our story -->
	<section class="bg-stone-50">
		<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
			<div
				class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2"
			>
				<div>
					<span
						class="text-sm font-semibold uppercase tracking-wider text-brand-600"
					>
						Our Story
					</span>
					<h2
						class="mt-4 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl"
					>
						From the family farm to a research field
					</h2>
					<p class="mt-6 text-base leading-relaxed text-stone-600">
						Kuijpers Research Field grew out of generations of
						hands-on poultry expertise. Working day to day with
						producers, we kept running into the same question: how do
						you know whether a new feed, climate setting or housing
						change will actually work before committing a whole flock
						to it? Trial and error in a live barn is slow, costly and
						hard to measure.
					</p>
					<p class="mt-4 text-base leading-relaxed text-stone-600">
						So we built a different kind of barn — an instrumented,
						sensor-rich research field paired with a digital twin that
						mirrors it in real time. Today we partner with universities,
						suppliers and producers to validate interventions
						independently, publish what we learn, and help the sector
						make decisions that improve welfare, cut environmental
						impact and strengthen the entire broiler value chain.
					</p>
				</div>
				<div class="overflow-hidden rounded-xl bg-stone-200 shadow-sm">
					<img
						src="/images/about-story.jpg"
						alt="Inside the Kuijpers research barn"
						width="800"
						height="600"
						class="aspect-[4/3] w-full object-cover"
						loading="lazy"
					/>
				</div>
			</div>
		</div>
	</section>

	<!-- 4. Team -->
	<section class="bg-white">
		<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-2xl text-center">
				<span
					class="text-sm font-semibold uppercase tracking-wider text-brand-600"
				>
					Our People
				</span>
				<h2
					class="mt-4 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl"
				>
					Meet the team
				</h2>
			</div>

			{
				team.length > 0 ? (
					<div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
						{team.map((member: any) => (
							<div class="flex flex-col overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm transition-shadow hover:shadow-md">
								{member.photo ? (
									<img
										src={urlFor(member.photo)
											.width(500)
											.height(500)
											.fit("crop")
											.url()}
										alt={member.name}
										width="500"
										height="500"
										class="aspect-square w-full object-cover"
										loading="lazy"
									/>
								) : (
									<div class="flex aspect-square w-full items-center justify-center bg-gradient-to-br from-brand-100 to-brand-50">
										<span class="text-3xl font-bold text-brand-400">
											{(member.name ?? "?")
												.charAt(0)
												.toUpperCase()}
										</span>
									</div>
								)}
								<div class="flex flex-1 flex-col p-5">
									<h3 class="text-lg font-semibold text-stone-900">
										{member.name}
									</h3>
									<p class="mt-1 flex-1 text-sm text-stone-600">
										{member.role}
									</p>
									{member.linkedin && (
										<a
											href={member.linkedin}
											target="_blank"
											rel="noopener noreferrer"
											aria-label={`${member.name} on LinkedIn`}
											class="mt-4 inline-flex h-9 w-9 items-center justify-center rounded-lg bg-stone-100 text-stone-500 transition-colors hover:bg-brand-50 hover:text-brand-600"
										>
											<svg
												class="h-5 w-5"
												viewBox="0 0 24 24"
												fill="currentColor"
												aria-hidden="true"
											>
												<path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" />
											</svg>
										</a>
									)}
								</div>
							</div>
						))}
					</div>
				) : (
					<p class="mt-12 text-center text-stone-500">
						Team profiles are coming soon — check back shortly.
					</p>
				)
			}
		</div>
	</section>

	<!-- 5. Partners -->
	<section class="bg-stone-50">
		<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
			<p
				class="text-center text-sm font-semibold uppercase tracking-wider text-stone-500"
			>
				Our Partners
			</p>
			<div
				class="mt-8 grid grid-cols-2 items-center gap-6 sm:grid-cols-3 lg:grid-cols-5"
			>
				{
					Array.from({ length: 5 }).map(() => (
						<div class="flex h-16 items-center justify-center rounded-lg bg-white shadow-sm">
							<span class="text-xs font-medium uppercase tracking-wider text-stone-400">
								Logo
							</span>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- 6. CTA -->
	<section class="bg-brand-800">
		<div class="mx-auto max-w-7xl px-4 py-20 text-center sm:px-6 lg:px-8">
			<h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
				Let's build something together
			</h2>
			<p
				class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-brand-100"
			>
				Curious how digital twin technology could support your research,
				products or production? We'd love to hear from you.
			</p>
			<div class="mt-10">
				<a
					href="/contact"
					class="inline-block rounded-lg bg-white px-8 py-3 text-base font-semibold text-brand-800 shadow-sm transition-colors hover:bg-stone-100"
				>
					Get in Touch
				</a>
			</div>
		</div>
	</section>
</BaseLayout>
