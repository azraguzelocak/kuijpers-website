---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllResearchProjects, getAllPublications } from "../../lib/sanity";
import { urlFor } from "../../lib/image";

// --- Data fetching ------------------------------------------------------
const projects = (await getAllResearchProjects()) ?? [];
const publications = (await getAllPublications()) ?? [];

// --- Portfolio counters (derived from real data) ------------------------
const countByStatus = (status: string) =>
	projects.filter((p: any) => p.status === status).length;
const stats = [
	{ value: countByStatus("ongoing"), label: "Ongoing" },
	{ value: countByStatus("completed"), label: "Completed" },
	{ value: countByStatus("planned"), label: "In Design" },
];

// --- Status presentation -----------------------------------------------
// Maps the CMS `status` enum (ongoing | completed | planned) to a label and
// badge colour. Kept here so both the badge and the filter bar share one
// source of truth.
const STATUS_META: Record<string, { label: string; badge: string }> = {
	ongoing: {
		label: "Ongoing",
		badge: "bg-emerald-100 text-emerald-800 ring-emerald-600/20",
	},
	completed: {
		label: "Completed",
		badge: "bg-brand-100 text-brand-800 ring-brand-600/20",
	},
	planned: {
		label: "Planned",
		badge: "bg-amber-100 text-amber-800 ring-amber-600/20",
	},
};
const statusMeta = (status: string) =>
	STATUS_META[status] ?? {
		label: status ?? "Unknown",
		badge: "bg-stone-100 text-stone-700 ring-stone-500/20",
	};

// Filter bar tabs — `all` plus each status in display order.
const filters = [
	{ value: "all", label: "All" },
	{ value: "ongoing", label: "Ongoing" },
	{ value: "completed", label: "Completed" },
	{ value: "planned", label: "Planned" },
];

const teamCount = (project: any) => (project.team?.length ?? 0);
---

<BaseLayout
	title="Research Projects — Kuijpers Research Field"
	description="Explore our research projects in poultry production — from emission monitoring to efficiency measurement — across ongoing, completed and planned work."
>
	<!-- 1. Hero -->
	<section class="relative overflow-hidden bg-stone-900">
		<!-- Full-bleed background photograph -->
		<img
			src="/images/research-hero.jpg"
			alt=""
			aria-hidden="true"
			class="absolute inset-0 h-full w-full object-cover"
			loading="eager"
		/>
		<!-- Cinematic dark overlay for legibility -->
		<div
			class="absolute inset-0 bg-gradient-to-b from-stone-950/70 via-stone-950/55 to-stone-950/75"
		>
		</div>
		<div
			class="relative mx-auto max-w-7xl px-4 py-28 sm:px-6 sm:py-32 lg:px-8"
		>
			<div class="mx-auto max-w-3xl text-center">
				<h1
					class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl"
				>
					Research Projects
				</h1>
				<p
					class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-stone-200 sm:text-xl"
				>
					From real-time emission monitoring to efficiency
					measurement, our research turns data from a controlled,
					sensor-rich environment into <span
						class="text-brand-300">validated insight</span
					> the whole value chain can trust. Browse our ongoing, completed and
					planned projects below.
				</p>
			</div>
		</div>
	</section>

	<!-- 1b. Intro block -->
	<section class="bg-stone-50">
		<div
			class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 lg:px-8 lg:py-28"
		>
			<span
				class="text-sm font-semibold uppercase tracking-[0.15em] text-brand-600"
			>
				Our Work
			</span>
			<h2
				class="mt-5 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl lg:text-[3.25rem] lg:leading-[1.1]"
			>
				The projects behind the <span class="text-brand-600">proof</span>.
			</h2>
			<p
				class="mx-auto mt-6 max-w-[680px] text-lg leading-[1.65] text-stone-600"
			>
				Every claim we make about poultry production is backed by a live
				research project — ongoing, completed, or in design. Browse the work
				shaping welfare standards, emission targets, and efficiency
				benchmarks across the sector.
			</p>

			<!-- Counter strip (stacked) -->
			<dl
				class="mx-auto mt-10 flex max-w-2xl flex-wrap items-start justify-center gap-x-10 gap-y-6 sm:gap-x-14"
			>
				{
					stats.map((stat) => (
						<div class="flex flex-col items-center">
							<dt class="order-2 mt-1 text-sm font-medium text-stone-500">
								{stat.label}
							</dt>
							<dd class="order-1 text-4xl font-extrabold tracking-tight text-stone-900 sm:text-5xl">
								{stat.value}
							</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<!-- 2. Filter bar + project grid -->
	<section class="bg-white">
		<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
			{
				projects.length > 0 ? (
					<>
						{/* Filter bar — buttons drive a small client script below */}
						<div
							id="status-filter"
							class="flex flex-wrap items-center justify-center gap-2"
							role="tablist"
							aria-label="Filter projects by status"
						>
							{filters.map((filter) => (
								<button
									type="button"
									class="status-filter-btn rounded-full border border-stone-200 px-5 py-2 text-sm font-semibold text-stone-600 transition-colors hover:bg-stone-50 aria-selected:border-brand-600 aria-selected:bg-brand-600 aria-selected:text-white"
									data-filter={filter.value}
									role="tab"
									aria-selected={filter.value === "all"}
								>
									{filter.label}
								</button>
							))}
						</div>

						{/* Project grid */}
						<div
							id="project-grid"
							class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3"
						>
							{projects.map((project: any) => {
								const meta = statusMeta(project.status);
								const count = teamCount(project);
								return (
									<article
										class="project-card group flex flex-col overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm transition-shadow hover:shadow-md"
										data-status={project.status ?? "unknown"}
									>
										<a
											href={`/research/${project.slug}`}
											class="flex flex-1 flex-col"
										>
											{/* Cover image */}
											<div class="relative aspect-[16/9] w-full overflow-hidden bg-gradient-to-br from-brand-100 to-brand-50">
												{project.coverImage ? (
													<img
														src={urlFor(project.coverImage)
															.width(800)
															.height(450)
															.fit("crop")
															.url()}
														alt={
															project.coverImage.alt ??
															project.title
														}
														width="800"
														height="450"
														class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
														loading="lazy"
													/>
												) : (
													<div class="flex h-full w-full items-center justify-center">
														<span class="text-sm font-medium text-brand-400">
															Kuijpers Research Field
														</span>
													</div>
												)}
												{/* Status badge */}
												<span
													class={`absolute left-4 top-4 inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset ${meta.badge}`}
												>
													{meta.label}
												</span>
											</div>

											{/* Body */}
											<div class="flex flex-1 flex-col p-6">
												<h2 class="text-xl font-semibold text-stone-900 group-hover:text-brand-700">
													{project.title}
												</h2>
												{project.summary && (
													<p class="mt-3 line-clamp-3 flex-1 text-base leading-relaxed text-stone-600">
														{project.summary}
													</p>
												)}

												{/* Meta row */}
												<div class="mt-5 flex items-center justify-between border-t border-stone-100 pt-4">
													<span class="inline-flex items-center gap-1.5 text-sm text-stone-500">
														<svg
															class="h-4 w-4"
															viewBox="0 0 24 24"
															fill="none"
															stroke="currentColor"
															stroke-width="2"
															stroke-linecap="round"
															stroke-linejoin="round"
															aria-hidden="true"
														>
															<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
															<circle cx="9" cy="7" r="4" />
															<path d="M22 21v-2a4 4 0 0 0-3-3.87" />
															<path d="M16 3.13a4 4 0 0 1 0 7.75" />
														</svg>
														{count}{" "}
														{count === 1
															? "team member"
															: "team members"}
													</span>
													<span class="inline-flex items-center gap-1 text-sm font-semibold text-brand-600">
														View project
														<svg
															class="h-4 w-4 transition-transform group-hover:translate-x-0.5"
															viewBox="0 0 24 24"
															fill="none"
															stroke="currentColor"
															stroke-width="2"
															stroke-linecap="round"
															stroke-linejoin="round"
															aria-hidden="true"
														>
															<path d="M5 12h14" />
															<path d="m12 5 7 7-7 7" />
														</svg>
													</span>
												</div>
											</div>
										</a>
									</article>
								);
							})}
						</div>

						{/* Empty state shown by the script when a filter has no matches */}
						<p
							id="filter-empty"
							class="mt-12 hidden text-center text-stone-500"
						>
							No projects match this filter yet — check back soon.
						</p>
					</>
				) : (
					<p class="text-center text-stone-500">
						Research projects are coming soon — check back shortly.
					</p>
				)
			}
		</div>
	</section>

	<!-- 3. CTA -->
	<section class="bg-brand-800">
		<div class="mx-auto max-w-7xl px-4 py-20 text-center sm:px-6 lg:px-8">
			<h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
				Have a research question?
			</h2>
			<p class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-brand-100">
				Tell us what you want to learn or validate, and we'll show you how
				our research field and digital twin can get you there.
			</p>
			<div class="mt-10">
				<a
					href="/contact"
					class="inline-block rounded-lg bg-white px-8 py-3 text-base font-semibold text-brand-800 shadow-sm transition-colors hover:bg-stone-100"
				>
					Get in Touch
				</a>
			</div>
		</div>
	</section>
</BaseLayout>

<script>
	// --- Status filter ---------------------------------------------------
	// Pure client-side filtering. Reads an optional `?status=` query param on
	// load so links like /research?status=ongoing land pre-filtered, and keeps
	// the URL in sync as the user clicks.
	const VALID = ["all", "ongoing", "completed", "planned"];

	const buttons = Array.from(
		document.querySelectorAll<HTMLButtonElement>(".status-filter-btn"),
	);
	const cards = Array.from(
		document.querySelectorAll<HTMLElement>(".project-card"),
	);
	const empty = document.getElementById("filter-empty");

	function apply(filter: string) {
		const value = VALID.includes(filter) ? filter : "all";
		let visible = 0;

		for (const card of cards) {
			const match = value === "all" || card.dataset.status === value;
			card.classList.toggle("hidden", !match);
			if (match) visible++;
		}

		for (const btn of buttons) {
			btn.setAttribute(
				"aria-selected",
				String(btn.dataset.filter === value),
			);
		}

		if (empty) empty.classList.toggle("hidden", visible > 0);

		// Keep URL shareable without adding history entries.
		const url = new URL(window.location.href);
		if (value === "all") url.searchParams.delete("status");
		else url.searchParams.set("status", value);
		window.history.replaceState({}, "", url);
	}

	for (const btn of buttons) {
		btn.addEventListener("click", () => apply(btn.dataset.filter ?? "all"));
	}

	// Initial state from the URL.
	apply(new URL(window.location.href).searchParams.get("status") ?? "all");
</script>
