---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TeamCard from "../../components/TeamCard.astro";
import { getAllResearchProjects } from "../../lib/sanity";
import { urlFor } from "../../lib/image";

// --- Static paths -------------------------------------------------------
// One page per research project. We fetch the full list once (it already
// carries every field the detail page needs) and hand each project to the
// template as a prop, so no per-page round-trip to Sanity is required.
export async function getStaticPaths() {
	const projects = (await getAllResearchProjects()) ?? [];
	return projects
		.filter((p: any) => p.slug)
		.map((project: any) => ({
			params: { slug: project.slug },
			props: {
				project,
				// Up to 3 other projects for the "Related" section.
				related: projects
					.filter((p: any) => p.slug && p.slug !== project.slug)
					.slice(0, 3),
			},
		}));
}

const { project, related } = Astro.props;

// --- Status presentation -----------------------------------------------
const STATUS_META: Record<string, { label: string; badge: string }> = {
	ongoing: {
		label: "Ongoing",
		badge: "bg-emerald-100 text-emerald-800 ring-emerald-600/20",
	},
	completed: {
		label: "Completed",
		badge: "bg-brand-100 text-brand-800 ring-brand-600/20",
	},
	planned: {
		label: "Planned",
		badge: "bg-amber-100 text-amber-800 ring-amber-600/20",
	},
};
const statusMeta = (status: string) =>
	STATUS_META[status] ?? {
		label: status ?? "Unknown",
		badge: "bg-stone-100 text-stone-700 ring-stone-500/20",
	};
const meta = statusMeta(project.status);

// --- Portable Text -> HTML ---------------------------------------------
// Minimal, dependency-free serializer for the `body` (blockContent) field —
// same approach used on /services. Handles paragraphs, headings and lists.
const esc = (s: string) =>
	s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const blockText = (block: any) =>
	(block.children ?? []).map((c: any) => esc(c.text ?? "")).join("");

function blocksToHtml(blocks: any): string {
	if (!Array.isArray(blocks)) return "";
	let html = "";
	let listTag: "ul" | "ol" | null = null;
	const closeList = () => {
		if (listTag) {
			html += `</${listTag}>`;
			listTag = null;
		}
	};
	for (const block of blocks) {
		if (block?._type !== "block") continue;
		const text = blockText(block);
		if (!text.trim()) continue;
		if (block.listItem) {
			const tag = block.listItem === "number" ? "ol" : "ul";
			if (listTag !== tag) {
				closeList();
				html += `<${tag} class="mt-4 space-y-2 ${
					tag === "ol" ? "list-decimal" : "list-disc"
				} pl-5 text-base leading-relaxed text-stone-600">`;
				listTag = tag;
			}
			html += `<li>${text}</li>`;
			continue;
		}
		closeList();
		if (typeof block.style === "string" && /^h[1-6]$/.test(block.style)) {
			html += `<h3 class="mt-6 text-xl font-semibold text-stone-900">${text}</h3>`;
		} else {
			html += `<p class="mt-4 text-base leading-relaxed text-stone-600">${text}</p>`;
		}
	}
	closeList();
	return html;
}

const bodyHtml = blocksToHtml(project.body);
const team = project.team ?? [];
const lead = project.lead ?? null;
const publications = project.relatedPublications ?? [];

// --- Date helpers -------------------------------------------------------
const fmtDate = (d?: string) =>
	d
		? new Date(d).toLocaleDateString("en-GB", {
				year: "numeric",
				month: "short",
			})
		: null;
const dateRange = [fmtDate(project.startDate), fmtDate(project.endDate)]
	.filter(Boolean)
	.join(" – ");

// --- Tab configuration --------------------------------------------------
// Single source of truth for the tabbed section. Each entry renders a tab
// button + a matching panel below. To add the Phase 2 "Tokens" tab, append
// one object here (e.g. { id: "tokens", label: "Tokens" }) and add a
// <div data-tab-panel="tokens"> block in the panels section — no JS changes
// and no page rebuild required.
const tabs = [
	{ id: "overview", label: "Overview" },
	{ id: "team", label: "Team" },
	{ id: "publications", label: "Publications" },
	{ id: "data", label: "Data" },
	// Phase 2: { id: "tokens", label: "Tokens" },
];
const defaultTab = "overview";
---

<BaseLayout
	title={`${project.title} — Research — Kuijpers Research Field`}
	description={project.summary ??
		`Research project: ${project.title} at Kuijpers Research Field.`}
>
	<!-- 1. Hero -->
	<section class="relative bg-stone-900 text-white">
		{
			project.coverImage && (
				<div class="absolute inset-0">
					<img
						src={urlFor(project.coverImage)
							.width(1920)
							.height(720)
							.fit("crop")
							.url()}
						alt={project.coverImage.alt ?? project.title}
						class="h-full w-full object-cover opacity-30"
						loading="eager"
					/>
					<div class="absolute inset-0 bg-gradient-to-t from-stone-900 via-stone-900/70 to-stone-900/40" />
				</div>
			)
		}
		<div class="relative mx-auto max-w-5xl px-4 py-24 sm:px-6 lg:px-8">
			<nav class="mb-6 text-sm text-stone-300">
				<a href="/research" class="transition-colors hover:text-white">
					Research
				</a>
				<span class="mx-2 text-stone-500">/</span>
				<span class="text-stone-100">{project.title}</span>
			</nav>

			<span
				class={`inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset ${meta.badge}`}
			>
				{meta.label}
			</span>

			<h1
				class="mt-5 text-4xl font-extrabold tracking-tight sm:text-5xl lg:text-6xl"
			>
				{project.title}
			</h1>

			{
				project.summary && (
					<p class="mt-6 max-w-3xl text-lg leading-relaxed text-stone-200 sm:text-xl">
						{project.summary}
					</p>
				)
			}

			{
				dateRange && (
					<p class="mt-6 inline-flex items-center gap-2 text-sm text-stone-300">
						<svg
							class="h-4 w-4"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M8 2v4" />
							<path d="M16 2v4" />
							<rect width="18" height="18" x="3" y="4" rx="2" />
							<path d="M3 10h18" />
						</svg>
						{dateRange}
					</p>
				)
			}
		</div>
	</section>

	<!-- 2. Tabbed content -->
	<section class="bg-white">
		<div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
			<!-- Tab bar -->
			<div class="border-b border-stone-200">
				<div
					id="tab-bar"
					class="-mb-px flex flex-wrap gap-x-6 gap-y-2"
					role="tablist"
					aria-label="Project details"
				>
					{
						tabs.map((tab) => (
							<button
								type="button"
								class="tab-btn border-b-2 border-transparent px-1 py-3 text-sm font-semibold text-stone-500 transition-colors hover:text-stone-800 aria-selected:border-brand-600 aria-selected:text-brand-700"
								data-tab={tab.id}
								role="tab"
								id={`tab-${tab.id}`}
								aria-controls={`panel-${tab.id}`}
								aria-selected={tab.id === defaultTab}
							>
								{tab.label}
							</button>
						))
					}
				</div>
			</div>

			<!-- Panels -->
			<div class="mt-10">
				<!-- Overview -->
				<div
					class="tab-panel"
					data-tab-panel="overview"
					id="panel-overview"
					role="tabpanel"
					aria-labelledby="tab-overview"
				>
					{
						bodyHtml ? (
							<div class="max-w-3xl" set:html={bodyHtml} />
						) : project.summary ? (
							<p class="max-w-3xl text-base leading-relaxed text-stone-600">
								{project.summary}
							</p>
						) : (
							<p class="text-stone-500">
								An overview for this project is coming soon.
							</p>
						)
					}

					{
						Array.isArray(project.tags) && project.tags.length > 0 && (
							<div class="mt-8 flex flex-wrap gap-2">
								{project.tags.map((tag: string) => (
									<span class="inline-flex items-center rounded-full bg-stone-100 px-3 py-1 text-xs font-medium text-stone-600">
										{tag}
									</span>
								))}
							</div>
						)
					}

					{
						project.fundingSource && (
							<p class="mt-8 text-sm text-stone-500">
								<span class="font-semibold text-stone-700">
									Funding:
								</span>{" "}
								{project.fundingSource}
							</p>
						)
					}
				</div>

				<!-- Team -->
				<div
					class="tab-panel hidden"
					data-tab-panel="team"
					id="panel-team"
					role="tabpanel"
					aria-labelledby="tab-team"
				>
					{
						lead || team.length > 0 ? (
							<div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
								{lead && (
									<TeamCard member={lead} isLead={true} />
								)}
								{team
									.filter(
										(m: any) => !lead || m._id !== lead._id,
									)
									.map((member: any) => (
										<TeamCard member={member} />
									))}
							</div>
						) : (
							<p class="text-stone-500">
								Team members will be announced soon.
							</p>
						)
					}
				</div>

				<!-- Publications -->
				<div
					class="tab-panel hidden"
					data-tab-panel="publications"
					id="panel-publications"
					role="tabpanel"
					aria-labelledby="tab-publications"
				>
					{
						publications.length > 0 ? (
							<ul class="divide-y divide-stone-100">
								{publications.map((pub: any) => {
									const href = pub.url ?? null;
									const inner = (
										<>
											<p class="text-base font-semibold text-stone-900 group-hover:text-brand-700">
												{pub.title}
											</p>
											{pub.publicationDate && (
												<p class="mt-1 text-sm text-stone-500">
													{fmtDate(
														pub.publicationDate,
													)}
												</p>
											)}
										</>
									);
									return (
										<li class="py-4">
											{href ? (
												<a
													href={href}
													target="_blank"
													rel="noopener noreferrer"
													class="group flex items-start justify-between gap-4"
												>
													<span>{inner}</span>
													<svg
														class="mt-1 h-4 w-4 flex-shrink-0 text-stone-400 group-hover:text-brand-600"
														viewBox="0 0 24 24"
														fill="none"
														stroke="currentColor"
														stroke-width="2"
														stroke-linecap="round"
														stroke-linejoin="round"
														aria-hidden="true"
													>
														<path d="M15 3h6v6" />
														<path d="M10 14 21 3" />
														<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
													</svg>
												</a>
											) : (
												<div>{inner}</div>
											)}
										</li>
									);
								})}
							</ul>
						) : (
							<p class="text-stone-500">
								No publications have been linked to this project
								yet.
							</p>
						)
					}
				</div>

				<!-- Data (placeholder for now) -->
				<div
					class="tab-panel hidden"
					data-tab-panel="data"
					id="panel-data"
					role="tabpanel"
					aria-labelledby="tab-data"
				>
					<div
						class="flex flex-col items-center justify-center rounded-xl border border-dashed border-stone-300 bg-stone-50 px-6 py-16 text-center"
					>
						<svg
							class="h-10 w-10 text-stone-400"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<ellipse cx="12" cy="5" rx="9" ry="3" />
							<path d="M3 5v14a9 3 0 0 0 18 0V5" />
							<path d="M3 12a9 3 0 0 0 18 0" />
						</svg>
						<h3 class="mt-4 text-lg font-semibold text-stone-900">
							Data coming soon
						</h3>
						<p class="mt-2 max-w-md text-sm leading-relaxed text-stone-500">
							Live datasets, dashboards and downloadable results
							from this project will appear here.
						</p>
					</div>
				</div>

				<!-- Phase 2: add a <div class="tab-panel hidden" data-tab-panel="tokens" ...> here -->
			</div>
		</div>
	</section>

	<!-- 3. Related projects -->
	{
		related.length > 0 && (
			<section class="bg-stone-50">
				<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
					<div class="flex items-end justify-between">
						<h2 class="text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl">
							Related projects
						</h2>
						<a
							href="/research"
							class="hidden text-sm font-semibold text-brand-600 hover:text-brand-700 sm:inline"
						>
							View all →
						</a>
					</div>

					<div class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
						{related.map((rel: any) => {
							const relMeta = statusMeta(rel.status);
							return (
								<a
									href={`/research/${rel.slug}`}
									class="group flex flex-col overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm transition-shadow hover:shadow-md"
								>
									<div class="relative aspect-[16/9] w-full overflow-hidden bg-gradient-to-br from-brand-100 to-brand-50">
										{rel.coverImage ? (
											<img
												src={urlFor(rel.coverImage)
													.width(700)
													.height(394)
													.fit("crop")
													.url()}
												alt={
													rel.coverImage.alt ??
													rel.title
												}
												width="700"
												height="394"
												class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
												loading="lazy"
											/>
										) : (
											<div class="flex h-full w-full items-center justify-center">
												<span class="text-sm font-medium text-brand-400">
													Kuijpers Research Field
												</span>
											</div>
										)}
										<span
											class={`absolute left-4 top-4 inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset ${relMeta.badge}`}
										>
											{relMeta.label}
										</span>
									</div>
									<div class="flex flex-1 flex-col p-6">
										<h3 class="text-lg font-semibold text-stone-900 group-hover:text-brand-700">
											{rel.title}
										</h3>
										{rel.summary && (
											<p class="mt-2 line-clamp-2 text-sm leading-relaxed text-stone-600">
												{rel.summary}
											</p>
										)}
									</div>
								</a>
							);
						})}
					</div>
				</div>
			</section>
		)
	}
</BaseLayout>

<script>
	// --- Tab switching ---------------------------------------------------
	// Driven entirely by data attributes so the tab set is whatever the
	// template renders — adding a Phase 2 "Tokens" tab needs no change here.
	const tabBar = document.getElementById("tab-bar");
	const buttons = Array.from(
		document.querySelectorAll<HTMLButtonElement>(".tab-btn"),
	);
	const panels = Array.from(
		document.querySelectorAll<HTMLElement>(".tab-panel"),
	);

	function activate(id: string) {
		for (const btn of buttons) {
			btn.setAttribute("aria-selected", String(btn.dataset.tab === id));
		}
		for (const panel of panels) {
			panel.classList.toggle("hidden", panel.dataset.tabPanel !== id);
		}
		// Reflect the tab in the URL hash so it is linkable/back-friendly.
		if (history.replaceState) {
			history.replaceState(null, "", `#${id}`);
		}
	}

	tabBar?.addEventListener("click", (e) => {
		const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(
			".tab-btn",
		);
		if (btn?.dataset.tab) activate(btn.dataset.tab);
	});

	// Honour a deep link like /research/slug#team on load.
	const fromHash = window.location.hash.replace("#", "");
	if (fromHash && buttons.some((b) => b.dataset.tab === fromHash)) {
		activate(fromHash);
	}
</script>
