---
import BaseLayout from "../layouts/BaseLayout.astro";
import InnovationExplorer from "../components/innovations/InnovationExplorer.tsx";
import FarmView3D from "../components/innovations/FarmView3D.astro";
---

<BaseLayout
	title="Innovations — Kuijpers Research Field"
	description="From research to real-world impact — 21 interconnected innovations across emissions, production, health and safety, and the measurable impact of each."
>
	<!-- 1. Hero -->
	<section class="relative overflow-hidden bg-stone-900">
		<!-- Full-bleed background photograph -->
		<img
			src="/images/innovations-hero.jpg"
			alt=""
			aria-hidden="true"
			class="absolute inset-0 h-full w-full object-cover"
			loading="eager"
		/>
		<!-- Cinematic dark overlay for legibility -->
		<div
			class="absolute inset-0 bg-gradient-to-b from-stone-950/70 via-stone-950/55 to-stone-950/75"
		>
		</div>
		<div
			class="relative mx-auto max-w-7xl px-4 py-28 sm:px-6 sm:py-32 lg:px-8"
		>
			<div class="mx-auto max-w-3xl text-center">
				<h1
					class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl"
				>
					From research to <span
						class="whitespace-nowrap text-brand-300">real-world impact</span
					>
				</h1>
				<p
					class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-stone-200 sm:text-xl"
				>
					The breakthroughs coming out of the Kuijpers Research Field — and
					the connected system that turns careful science into measurable
					results on the farm.
				</p>
			</div>
		</div>
	</section>

	<!-- 2. Explore the site — 3D farm model -->
	<FarmView3D />

	<!-- 3. Interactive innovation explorer -->
	<section class="bg-white">
		<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8 lg:py-24">
			<div class="mx-auto mb-12 max-w-3xl text-center">
				<span
					class="text-sm font-semibold uppercase tracking-[0.15em] text-brand-600"
				>
					Interconnected
				</span>
				<h2
					class="mt-5 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl"
				>
					One vision, not a list
				</h2>
				<p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-stone-600">
					Our innovations don't work in isolation — each one supports and
					strengthens the others. Rotate the network to see how they link
					up, then open any one for its full story and its real impact on
					CO₂, ammonia, energy, water and nutrients.
				</p>
			</div>

			<InnovationExplorer client:visible />
		</div>
	</section>
</BaseLayout>
