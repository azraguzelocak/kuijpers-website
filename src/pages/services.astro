---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAllServices, getAllAdvantages } from "../lib/sanity";
import { urlFor } from "../lib/image";

// --- Data fetching ------------------------------------------------------
const services = (await getAllServices()) ?? [];
const advantages = (await getAllAdvantages()) ?? [];

// `target audience` has no dedicated CMS field yet — derive it from the
// service title via keyword match, with a sensible default. Promote to a
// Sanity field when content needs richer per-service audiences.
const defaultAudience =
	"Researchers, suppliers and producers working to improve poultry production.";

const audienceFor = (title: string = "") => {
	const t = title.toLowerCase();
	if (t.includes("integrated")) return "Suppliers and innovation partners";
	if (t.includes("optimization") || t.includes("optimisation"))
		return "Processors and purchasers";
	if (t.includes("digital twin")) return "Researchers and academia";
	return defaultAudience;
};

// --- Process steps ------------------------------------------------------
const steps = [
	{
		title: "Discovery",
		body: "We start by understanding your question, constraints and success criteria — mapping what you want to learn or validate before any sensors are placed.",
	},
	{
		title: "Design",
		body: "We design the trial and its digital twin together: housing, instrumentation, data pipelines and the analysis plan that will produce defensible results.",
	},
	{
		title: "Implementation",
		body: "We run the intervention in our instrumented research field, capturing real-time data while the digital twin mirrors conditions throughout the cycle.",
	},
	{
		title: "Monitoring",
		body: "We continuously monitor, validate and report — turning raw signals into clear, independently verifiable insight you can act on with confidence.",
	},
];

// --- "Why us" stat blocks ----------------------------------------------
// The advantage schema has no numeric `stat` field, so we supply positional
// fallbacks to keep the stat grid visually balanced (same approach as the
// homepage advantages strip). Promote `stat` to a Sanity field to make these
// CMS-driven.
const statFallbacks = [
	{ stat: "20%", description: "Lower feed conversion ratio." },
	{ stat: "24/7", description: "Continuous real-time monitoring." },
	{ stat: "100%", description: "Independently validated results." },
	{ stat: "3×", description: "Faster intervention testing." },
];
const statBlocks = Array.from({ length: 4 }).map((_, i) => {
	const a = advantages[i];
	return {
		stat: a?.stat ?? statFallbacks[i].stat,
		title: a?.title ?? statFallbacks[i].description,
		description: a?.description ?? statFallbacks[i].description,
	};
});

// --- Comparison rows ----------------------------------------------------
const comparison = [
	{
		aspect: "Evidence",
		traditional: "Opinion and benchmarks from elsewhere",
		kuijpers: "Data measured in a controlled research field",
	},
	{
		aspect: "Validation",
		traditional: "Recommendations rarely tested before rollout",
		kuijpers: "Interventions validated in a digital twin first",
	},
	{
		aspect: "Risk",
		traditional: "Trial and error in your live flock",
		kuijpers: "Trial in our barn — your flock stays protected",
	},
	{
		aspect: "Monitoring",
		traditional: "Periodic site visits and snapshots",
		kuijpers: "Continuous, real-time sensor data 24/7",
	},
	{
		aspect: "Transparency",
		traditional: "Black-box conclusions",
		kuijpers: "Open methods and independently verifiable results",
	},
	{
		aspect: "Speed",
		traditional: "Months to see results in the field",
		kuijpers: "Faster cycles through parallel digital testing",
	},
];
---

<BaseLayout
	title="Our Services — Kuijpers Research Field"
	description="Digital twin services for poultry production — from trial design and real-time monitoring to independent validation — and why teams choose Kuijpers Research Field."
>
	<!-- 1. Hero -->
	<section class="relative overflow-hidden bg-stone-900">
		<!-- Full-bleed background photograph -->
		<img
			src="/images/service-hero.jpg"
			alt=""
			aria-hidden="true"
			class="absolute inset-0 h-full w-full object-cover"
			loading="eager"
		/>
		<!-- Cinematic dark overlay for legibility -->
		<div
			class="absolute inset-0 bg-gradient-to-b from-stone-950/70 via-stone-950/55 to-stone-950/75"
		>
		</div>
		<div
			class="relative mx-auto max-w-7xl px-4 py-28 sm:px-6 sm:py-32 lg:px-8"
		>
			<div class="mx-auto max-w-3xl text-center">
				<h1
					class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl"
				>
					Our Services
				</h1>
				<p
					class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-stone-200 sm:text-xl"
				>
					From trial design to real-time monitoring, we help you test
					and validate interventions in a controlled, data-rich
					environment — pairing a fully instrumented research field with
					a digital twin that mirrors it in real time.
				</p>
			</div>
		</div>
	</section>

	<!-- 1b. Intro block -->
	<section class="bg-stone-50">
		<div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 lg:px-8 lg:py-28">
			<span
				class="text-sm font-semibold uppercase tracking-[0.15em] text-brand-600"
			>
				What We Do
			</span>
			<h2
				class="mt-5 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl lg:text-[3.25rem] lg:leading-[1.1]"
			>
				Built for <span class="text-brand-600">the questions</span> you can't
				ask a live barn.
			</h2>
			<p
				class="mx-auto mt-6 max-w-[680px] text-lg leading-[1.65] text-stone-600"
			>
				Whether you're validating a feed innovation, optimizing a supply
				chain, or designing a multi-year research program, we run the full
				process inside the research field — from first hypothesis to final,
				publication-grade result.
			</p>
		</div>
	</section>

	<!-- 2. Service cards (grid layout) -->
	<section class="bg-white">
		<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
			{
				services.length > 0 ? (
					<div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
						{services.map((service: any) => (
							<div class="flex flex-col overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm transition-shadow hover:shadow-md">
								{/* Image */}
								{service.image ? (
									<img
										src={urlFor(service.image)
											.width(720)
											.height(432)
											.fit("crop")
											.url()}
										alt={service.image.alt ?? service.title}
										width="720"
										height="432"
										class="aspect-[5/3] w-full object-cover"
										loading="lazy"
									/>
								) : (
									<div class="flex aspect-[5/3] w-full items-center justify-center bg-gradient-to-br from-brand-100 to-brand-50">
										<span class="text-sm font-medium text-brand-400">
											Kuijpers Research Field
										</span>
									</div>
								)}

								{/* Body */}
								<div class="flex flex-1 flex-col p-6">
									<h2 class="text-xl font-semibold text-stone-900">
										{service.title}
									</h2>

									{service.shortDescription && (
										<p class="mt-3 text-base leading-relaxed text-stone-600">
											{service.shortDescription}
										</p>
									)}

									{/* Key features */}
									{Array.isArray(service.features) &&
										service.features.length > 0 && (
											<ul class="mt-5 space-y-2">
												{service.features.map(
													(feature: string) => (
														<li class="flex items-start gap-2 text-sm leading-relaxed text-stone-700">
															<svg
																class="mt-0.5 h-4 w-4 flex-shrink-0 text-brand-600"
																viewBox="0 0 24 24"
																fill="none"
																stroke="currentColor"
																stroke-width="2"
																stroke-linecap="round"
																stroke-linejoin="round"
																aria-hidden="true"
															>
																<path d="M20 6 9 17l-5-5" />
															</svg>
															<span>{feature}</span>
														</li>
													),
												)}
											</ul>
										)}

									{/* Who it's for */}
									<div class="mt-auto pt-6">
										<p class="text-xs font-semibold uppercase tracking-wider text-brand-600">
											Who it's for
										</p>
										<p class="mt-1 text-sm leading-relaxed text-stone-500">
											{audienceFor(service.title)}
										</p>
									</div>
								</div>
							</div>
						))}
					</div>
				) : (
					<p class="text-center text-stone-500">
						Service details are coming soon — get in touch and we'll
						walk you through what we offer.
					</p>
				)
			}
		</div>
	</section>

	<!-- 3. Process -->
	<section class="bg-brand-950 text-white">
		<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-2xl text-center">
				<span
					class="text-sm font-semibold uppercase tracking-wider text-brand-300"
				>
					How We Work
				</span>
				<h2
					class="mt-4 text-3xl font-bold tracking-tight text-white sm:text-4xl"
				>
					From question to validated insight
				</h2>
			</div>

			<div class="mt-16 grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-4">
				{
					steps.map((step, i) => (
						<div class="flex flex-col items-center text-center sm:items-start sm:text-left">
							<div class="flex h-14 w-14 items-center justify-center rounded-full bg-brand-600 text-xl font-bold text-white">
								{i + 1}
							</div>
							<h3 class="mt-5 text-lg font-semibold text-white">
								{step.title}
							</h3>
							<p class="mt-2 text-sm leading-relaxed text-brand-200">
								{step.body}
							</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- 4. Why us — stat blocks -->
	<section class="bg-white">
		<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-2xl text-center">
				<span
					class="text-sm font-semibold uppercase tracking-wider text-brand-600"
				>
					Why Kuijpers Research Field
				</span>
				<h2
					class="mt-4 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl"
				>
					Evidence you can act on
				</h2>
			</div>

			<div
				class="mt-12 grid grid-cols-1 gap-10 text-center sm:grid-cols-2 lg:grid-cols-4"
			>
				{
					statBlocks.map((block) => (
						<div class="flex flex-col items-center">
							<p class="text-5xl font-extrabold tracking-tight text-brand-600">
								{block.stat}
							</p>
							<p class="mt-3 text-lg font-semibold text-stone-900">
								{block.title}
							</p>
							<p class="mt-2 text-sm leading-relaxed text-stone-600">
								{block.description}
							</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- 5. The Difference (side-by-side comparison) -->
	<section class="bg-stone-50">
		<div class="mx-auto max-w-5xl px-4 py-20 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-2xl text-center">
				<span
					class="text-sm font-semibold uppercase tracking-wider text-brand-600"
				>
					The Difference
				</span>
				<h2
					class="mt-4 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl"
				>
					Traditional consulting vs. the Kuijpers approach
				</h2>
			</div>

			<div class="mt-12 grid items-stretch gap-6 lg:grid-cols-2 lg:gap-8">
				<!-- Traditional consulting -->
				<div
					class="flex flex-col rounded-2xl border border-stone-200 bg-white p-8 shadow-sm"
				>
					<h3 class="text-lg font-semibold text-stone-500">
						Traditional consulting
					</h3>
					<ul class="mt-6 space-y-5">
						{comparison.map((row) => (
							<li class="flex items-start gap-3">
								<svg
									class="mt-0.5 h-5 w-5 flex-shrink-0 text-stone-300"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2.5"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d="M18 6 6 18" />
									<path d="m6 6 12 12" />
								</svg>
								<div>
									<p class="text-xs font-semibold uppercase tracking-wider text-stone-400">
										{row.aspect}
									</p>
									<p class="mt-0.5 text-base leading-relaxed text-stone-500">
										{row.traditional}
									</p>
								</div>
							</li>
						))}
					</ul>
				</div>

				<!-- The Kuijpers approach (elevated) -->
				<div
					class="relative flex flex-col rounded-2xl bg-brand-700 p-8 text-white shadow-xl ring-1 ring-brand-600 lg:-translate-y-2"
				>
					<span
						class="absolute right-6 top-6 inline-flex items-center rounded-full bg-white/15 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-white"
					>
						Our approach
					</span>
					<h3 class="text-lg font-bold text-white">
						The Kuijpers approach
					</h3>
					<ul class="mt-6 space-y-5">
						{comparison.map((row) => (
							<li class="flex items-start gap-3">
								<svg
									class="mt-0.5 h-5 w-5 flex-shrink-0 text-white"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2.5"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d="M20 6 9 17l-5-5" />
								</svg>
								<div>
									<p class="text-xs font-semibold uppercase tracking-wider text-brand-200">
										{row.aspect}
									</p>
									<p class="mt-0.5 text-base font-medium leading-relaxed text-white">
										{row.kuijpers}
									</p>
								</div>
							</li>
						))}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<!-- 6. Referrals -->
	<section class="bg-white">
		<div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-2xl text-center">
				<span class="text-sm font-semibold uppercase tracking-wider text-brand-600">
					Referrals
				</span>
				<h2 class="mt-4 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl">
					What our partners say
				</h2>
			</div>
			<div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-2">
				{[
					{
						quote:
							"Working with Kuijpers Kip Research Field helped us to gain the necessary insights to move to emission-free poultry production.",
						name: "Maurice Ortmans",
						company: "Inno+",
					},
					{
						quote:
							"Vision and implementation power makes all the difference.",
						name: "Cor van de Ven",
						company: "Vencomatic",
					},
				].map((t) => (
					<figure class="flex h-full flex-col rounded-2xl border border-stone-200 bg-stone-50 p-8 shadow-sm">
						<svg
							class="h-9 w-9 text-brand-300"
							viewBox="0 0 24 24"
							fill="currentColor"
							aria-hidden="true"
						>
							<path d="M9.13 8.5C7.4 9.6 6.5 11.2 6.5 13.2c0 .3 0 .6.1.9.4-.2.8-.3 1.3-.3 1.5 0 2.7 1.2 2.7 2.8 0 1.6-1.3 2.9-2.9 2.9-2 0-3.6-1.7-3.6-4.3 0-3.5 2-6.3 5.2-7.9l.83 1.2zm8 0c-1.73 1.1-2.63 2.7-2.63 4.7 0 .3 0 .6.1.9.4-.2.8-.3 1.3-.3 1.5 0 2.7 1.2 2.7 2.8 0 1.6-1.3 2.9-2.9 2.9-2 0-3.6-1.7-3.6-4.3 0-3.5 2-6.3 5.2-7.9l.83 1.2z" />
						</svg>
						<blockquote class="mt-5 flex-1 text-xl font-medium leading-relaxed text-stone-800">
							{t.quote}
						</blockquote>
						<figcaption class="mt-6 border-t border-stone-100 pt-5">
							<p class="text-base font-semibold text-stone-900">{t.name}</p>
							<p class="text-sm text-stone-500">{t.company}</p>
						</figcaption>
					</figure>
				))}
			</div>
		</div>
	</section>

	<!-- 7. CTA -->
	<section class="bg-brand-800">
		<div class="mx-auto max-w-7xl px-4 py-20 text-center sm:px-6 lg:px-8">
			<h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
				Discuss your project
			</h2>
			<p
				class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-brand-100"
			>
				Tell us what you want to learn or validate, and we'll show you how
				digital twin technology can get you there.
			</p>
			<div class="mt-10">
				<a
					href="/contact"
					class="inline-block rounded-lg bg-white px-8 py-3 text-base font-semibold text-brand-800 shadow-sm transition-colors hover:bg-stone-100"
				>
					Get in Touch
				</a>
			</div>
		</div>
	</section>
</BaseLayout>
