---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSiteSettings } from "../lib/sanity";

// --- Data fetching ------------------------------------------------------
// Pull contact details from Sanity site settings, with safe fallbacks.
const settings = (await getSiteSettings()) ?? {};

const company: string = settings.siteTitle ?? "Kuijpers Research Field";
const email: string = settings.email ?? "jan@kuijperskip.com";
const phone: string = settings.phone ?? "+31 (0)6 28427410";
const address: string =
	settings.address ?? "Witveldweg 35\nGrubbenvorst\nThe Netherlands";

// Date this policy was last reviewed/updated.
const lastUpdated = "29 May 2026";
---

<BaseLayout
	title={`Privacy Policy — ${company}`}
	description={`How ${company} collects, uses, stores and protects your personal data, and the rights you have under the GDPR.`}
>
	<!-- Hero -->
	<section class="bg-stone-50">
		<div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 lg:px-8">
			<p
				class="text-sm font-semibold uppercase tracking-wider text-brand-600"
			>
				Legal
			</p>
			<h1
				class="mt-3 text-4xl font-extrabold tracking-tight text-stone-900 sm:text-5xl"
			>
				Privacy Policy
			</h1>
			<p class="mt-4 text-base text-stone-500">
				Last updated: {lastUpdated}
			</p>
		</div>
	</section>

	<!-- Body -->
	<section class="bg-white">
		<div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
			<article
				class="space-y-10 text-base leading-relaxed text-stone-700
					[&_h2]:mt-2 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:tracking-tight [&_h2]:text-stone-900
					[&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-stone-900
					[&_p]:mt-3
					[&_ul]:mt-3 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-6
					[&_a]:font-medium [&_a]:text-brand-600 [&_a:hover]:underline"
			>
				<div>
					<p class="mt-0">
						{company} ("we", "us", "our") respects your privacy and is
						committed to protecting your personal data. This privacy
						policy explains what personal data we collect, why we collect
						it, the legal basis for processing it, how long we keep it,
						and the rights you have. It applies to visitors of our website
						and people who contact us.
					</p>
					<p>
						We process personal data in accordance with the EU General
						Data Protection Regulation (Regulation (EU) 2016/679, the
						"GDPR") and the Dutch GDPR Implementation Act (Uitvoeringswet
						Algemene verordening gegevensbescherming, "UAVG").
					</p>
				</div>

				<div>
					<h2>1. Data controller</h2>
					<p>
						{company} is the controller responsible for your personal
						data. You can reach us at:
					</p>
					<address class="mt-3 whitespace-pre-line not-italic text-stone-700">
						{company}
{address}
					</address>
					<p>
						Email: <a href={`mailto:${email}`}>{email}</a><br />
						Phone: <a href={`tel:${phone.replace(/[^+\d]/g, "")}`}
							>{phone}</a
						>
					</p>
				</div>

				<div>
					<h2>2. What personal data we collect</h2>
					<p>
						We only collect personal data that you provide to us
						voluntarily or that is strictly necessary to operate our
						website. Specifically:
					</p>

					<h3 class="mt-6">Information you give us</h3>
					<ul>
						<li>
							<strong>Contact form data</strong> — when you use our
							contact form, we collect your name, email address,
							(optional) company name, subject and the contents of your
							message.
						</li>
						<li>
							<strong>Correspondence</strong> — if you email or call us,
							we keep a record of that correspondence, including your
							contact details and the content of your message.
						</li>
					</ul>

					<h3 class="mt-6">Information collected automatically</h3>
					<ul>
						<li>
							<strong>Anonymous usage statistics</strong> — we use
							Plausible Analytics to understand how our website is used.
							Plausible is a privacy-friendly tool that does not use
							cookies and does not collect any personally identifiable
							information. It does not track you across websites or
							devices. See our <a href="/cookies">Cookie Policy</a> for
							details.
						</li>
					</ul>
					<p>
						Our content is delivered through Sanity, our content
						management system. Sanity does not place third-party tracking
						cookies or profile visitors.
					</p>
					<p>
						We do <strong>not</strong> collect special categories of
						personal data (such as data about health, ethnicity or
						political opinions), and we do not knowingly collect data from
						children under 16.
					</p>
				</div>

				<div>
					<h2>3. Purposes and legal bases for processing</h2>
					<p>
						Under the GDPR, we may only process your personal data when we
						have a valid legal basis. The table below sets out what we do
						and why.
					</p>
					<div class="mt-4 overflow-x-auto">
						<table
							class="w-full border-collapse text-left text-sm
								[&_td]:border-t [&_td]:border-stone-200 [&_td]:px-4 [&_td]:py-3 [&_td]:align-top
								[&_th]:px-4 [&_th]:py-3 [&_th]:font-semibold [&_th]:text-stone-900"
						>
							<thead class="bg-stone-50">
								<tr>
									<th>Purpose</th>
									<th>Data used</th>
									<th>Legal basis</th>
								</tr>
							</thead>
							<tbody class="text-stone-700">
								<tr>
									<td>Responding to your enquiry</td>
									<td>Name, email, company, message</td>
									<td
										>Legitimate interest (Art. 6(1)(f)) — to answer
										and follow up on requests you send us</td
									>
								</tr>
								<tr>
									<td>Maintaining and securing our website</td>
									<td>Aggregated, anonymous usage data</td>
									<td
										>Legitimate interest (Art. 6(1)(f)) — to keep
										our website working, secure and improved</td
									>
								</tr>
								<tr>
									<td>Complying with legal obligations</td>
									<td>Relevant correspondence and records</td>
									<td
										>Legal obligation (Art. 6(1)(c)) — where the law
										requires us to keep records</td
									>
								</tr>
							</tbody>
						</table>
					</div>
				</div>

				<div>
					<h2>4. How we share your data</h2>
					<p>
						We do not sell your personal data. We only share it where
						necessary:
					</p>
					<ul>
						<li>
							<strong>Service providers (processors)</strong> — trusted
							providers who process data on our behalf and under our
							instructions, such as our email delivery provider (Resend)
							and our hosting and content infrastructure. These providers
							are bound by data processing agreements.
						</li>
						<li>
							<strong>Authorities</strong> — where we are legally
							required to disclose information to competent authorities.
						</li>
					</ul>
					<p>
						Some of our service providers may process data outside the
						European Economic Area (EEA). Where that is the case, we
						ensure appropriate safeguards are in place, such as the
						European Commission's Standard Contractual Clauses.
					</p>
				</div>

				<div>
					<h2>5. How long we keep your data</h2>
					<p>
						We keep personal data only for as long as necessary for the
						purposes for which it was collected:
					</p>
					<ul>
						<li>
							<strong>Contact enquiries</strong> — kept for up to 24
							months after our last contact with you, then deleted,
							unless an ongoing relationship or legal obligation requires
							us to keep it longer.
						</li>
						<li>
							<strong>Analytics data</strong> — aggregated and anonymous,
							so it is not linked to any identifiable individual.
						</li>
					</ul>
				</div>

				<div>
					<h2>6. Your rights</h2>
					<p>
						Under the GDPR, you have the following rights in relation to
						your personal data:
					</p>
					<ul>
						<li><strong>Access</strong> — request a copy of the personal data we hold about you.</li>
						<li><strong>Rectification</strong> — ask us to correct inaccurate or incomplete data.</li>
						<li><strong>Erasure</strong> — ask us to delete your data ("right to be forgotten").</li>
						<li><strong>Restriction</strong> — ask us to limit how we use your data.</li>
						<li><strong>Objection</strong> — object to processing based on our legitimate interests.</li>
						<li><strong>Data portability</strong> — receive your data in a structured, commonly used, machine-readable format.</li>
						<li><strong>Withdraw consent</strong> — where processing is based on consent, withdraw it at any time without affecting prior processing.</li>
					</ul>
					<p>
						To exercise any of these rights, contact us at <a
							href={`mailto:${email}`}>{email}</a
						>. We will respond within one month. There is normally no
						charge.
					</p>
					<p>
						If you believe we have not handled your personal data properly,
						you have the right to lodge a complaint with the Dutch Data
						Protection Authority (Autoriteit Persoonsgegevens) at <a
							href="https://www.autoriteitpersoonsgegevens.nl"
							target="_blank"
							rel="noopener noreferrer"
							>autoriteitpersoonsgegevens.nl</a
						>.
					</p>
				</div>

				<div>
					<h2>7. How we protect your data</h2>
					<p>
						We take appropriate technical and organisational measures to
						protect your personal data against loss, misuse and
						unauthorised access, including encryption in transit (HTTPS),
						access controls and the use of reputable, GDPR-compliant
						service providers.
					</p>
				</div>

				<div>
					<h2>8. Changes to this policy</h2>
					<p>
						We may update this privacy policy from time to time. When we
						do, we will revise the "last updated" date at the top of this
						page. We encourage you to review this page periodically.
					</p>
				</div>

				<div>
					<h2>9. Contact us</h2>
					<p>
						If you have any questions about this privacy policy or how we
						handle your personal data, please contact us:
					</p>
					<p>
						Email: <a href={`mailto:${email}`}>{email}</a><br />
						Phone: <a href={`tel:${phone.replace(/[^+\d]/g, "")}`}
							>{phone}</a
						>
					</p>
				</div>
			</article>
		</div>
	</section>
</BaseLayout>
