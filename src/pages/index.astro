---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
	getAllServices,
	getAllResearchProjects,
	getAllAdvantages,
	getAllNews,
} from "../lib/sanity";
import { urlFor } from "../lib/image";

// --- Data fetching ------------------------------------------------------
const services = (await getAllServices()) ?? [];
const allResearch = (await getAllResearchProjects()) ?? [];
const advantages = (await getAllAdvantages()) ?? [];
const allNews = (await getAllNews()) ?? [];

// Featured research: 3 most recent (query is already ordered).
const featuredResearch = allResearch.slice(0, 3);
// Latest news: 3 most recent (query is already ordered).
const latestNews = allNews.slice(0, 3);

// --- Lucide-style icon map ---------------------------------------------
// Inner SVG markup keyed by the `icon` string stored on each service.
// Rendered inside a <svg fill="none" stroke="currentColor"> wrapper below.
// Unknown / missing keys fall back to `default`.
const icons: Record<string, string> = {
	users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
	database:
		'<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/>',
	cpu: '<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2"/>',
	leaf: '<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>',
	chart: '<path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>',
	"bar-chart":
		'<path d="M3 3v18h18"/><path d="M18 17V9"/><path d="M13 17V5"/><path d="M8 17v-3"/>',
	"line-chart": '<path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/>',
	beaker: '<path d="M4.5 3h15"/><path d="M6 3v16a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V3"/><path d="M6 14h12"/>',
	flask: '<path d="M8.5 2h7"/><path d="M14 2v6a2 2 0 0 0 .245.96l5.51 10.08A2 2 0 0 1 18 22H6a2 2 0 0 1-1.755-2.96l5.51-10.08A2 2 0 0 0 10 8V2"/><path d="M6.453 15h11.094"/>',
	microscope:
		'<path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/><path d="M9 14h2"/><path d="M9 6h.01"/><path d="M8 6h8a1 1 0 0 1 1 1v2H7V7a1 1 0 0 1 1-1Z"/>',
	default:
		'<path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .962 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.582a.5.5 0 0 1 0 .962L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.962 0z"/><path d="M20 3v4"/><path d="M22 5h-4"/><path d="M4 17v2"/><path d="M5 18H3"/>',
};
const iconMarkup = (key?: string | null) =>
	icons[(key ?? "").toLowerCase()] ?? icons.default;

// Status badge styling for research cards.
const statusStyles: Record<string, string> = {
	ongoing: "bg-brand-50 text-brand-700",
	completed: "bg-emerald-50 text-emerald-700",
	planned: "bg-amber-50 text-amber-700",
};
const statusLabel = (s?: string) =>
	s ? s.charAt(0).toUpperCase() + s.slice(1) : "Research";

// Fallback stats so the advantages strip stays visually balanced before the
// `stat`/`description` fields are populated in the CMS.
const advantageFallbacks = [
	{ stat: "20%", description: "Lower feed conversion ratio." },
	{ stat: "24/7", description: "Continuous real-time monitoring." },
	{ stat: "100%", description: "Independently validated results." },
	{ stat: "3×", description: "Faster intervention testing." },
];

// Date formatter for news teasers.
const formatDate = (value?: string) =>
	value
		? new Date(value).toLocaleDateString("en-GB", {
				day: "numeric",
				month: "long",
				year: "numeric",
			})
		: "";
---

<BaseLayout
	title="Kuijpers Research Field — Digital Twins for Poultry Production"
	description="Digital twin technology for smarter, healthier and more sustainable poultry production."
>
	<!-- 1. Hero -->
	<section class="bg-stone-50">
		<div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-3xl text-center">
				<h1
					class="text-4xl font-extrabold tracking-tight text-stone-900 sm:text-5xl lg:text-6xl"
				>
					Digital twin technology for sustainable poultry
					production
				</h1>
				<p
					class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-stone-600 sm:text-xl"
				>
					We build virtual replicas of poultry production systems that
					turn real-time data into actionable insight — advancing
					animal welfare, efficiency and sustainability with
					research-grade technology.
				</p>
				<div
					class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row"
				>
					<a
						href="/research"
						class="w-full rounded-lg bg-brand-600 px-6 py-3 text-center text-base font-semibold text-white shadow-sm transition-colors hover:bg-brand-700 sm:w-auto"
					>
						Explore Our Research
					</a>
					<a
						href="/contact"
						class="w-full rounded-lg border border-stone-300 bg-white px-6 py-3 text-center text-base font-semibold text-stone-700 transition-colors hover:bg-stone-100 sm:w-auto"
					>
						Get in Touch
					</a>
				</div>
			</div>
		</div>
	</section>

	<!-- 2. Mission -->
	<section class="bg-white">
		<div class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6 lg:px-8">
			<span
				class="text-sm font-semibold uppercase tracking-wider text-brand-600"
			>
				Our Mission
			</span>
			<h2
				class="mt-4 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl"
			>
				Bridging science and practice for a more sustainable food
				system
			</h2>
			<p class="mt-6 text-lg leading-relaxed text-stone-600">
				Kuijpers Research Field unites cutting-edge digital twin
				technology with hands-on poultry expertise. By validating
				interventions in a controlled, data-rich environment, we help
				researchers, suppliers and producers make decisions that improve
				animal welfare, reduce environmental impact and strengthen the
				entire broiler value chain.
			</p>
		</div>
	</section>

	<!-- 3. Services preview -->
	<section class="bg-stone-50">
		<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-2xl text-center">
				<span
					class="text-sm font-semibold uppercase tracking-wider text-brand-600"
				>
					What We Offer
				</span>
				<h2
					class="mt-4 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl"
				>
					Our services
				</h2>
			</div>

			<div
				class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4"
			>
				{
					services.map((service: any) => (
						<div class="flex flex-col rounded-xl border border-stone-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md">
							<div class="flex h-12 w-12 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
								<svg
									class="h-6 w-6"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
									set:html={iconMarkup(service.icon)}
								/>
							</div>
							<h3 class="mt-5 text-lg font-semibold text-stone-900">
								{service.title}
							</h3>
							<p class="mt-2 flex-1 text-sm leading-relaxed text-stone-600">
								{service.shortDescription}
							</p>
							<a
								href="/services"
								class="mt-4 inline-flex items-center text-sm font-semibold text-brand-600 transition-colors hover:text-brand-700"
							>
								Learn more &rarr;
							</a>
						</div>
					))
				}
			</div>

			<div class="mt-12 text-center">
				<a
					href="/services"
					class="inline-flex items-center text-base font-semibold text-brand-600 transition-colors hover:text-brand-700"
				>
					See all services &rarr;
				</a>
			</div>
		</div>
	</section>

	<!-- 4. Featured research -->
	<section class="bg-white">
		<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-2xl text-center">
				<span
					class="text-sm font-semibold uppercase tracking-wider text-brand-600"
				>
					Featured Research
				</span>
				<h2
					class="mt-4 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl"
				>
					Recent projects
				</h2>
			</div>

			<div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-3">
				{
					featuredResearch.map((project: any) => (
						<a
							href={`/research/${project.slug}`}
							class="group flex flex-col overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm transition-shadow hover:shadow-md"
						>
							{project.coverImage ? (
								<img
									src={urlFor(project.coverImage)
										.width(800)
										.height(500)
										.fit("crop")
										.url()}
									alt={project.title}
									width="800"
									height="500"
									class="aspect-[8/5] w-full object-cover"
									loading="lazy"
								/>
							) : (
								<div class="flex aspect-[8/5] w-full items-center justify-center bg-gradient-to-br from-brand-100 to-brand-50">
									<span class="text-sm font-medium text-brand-400">
										Kuijpers Research Field
									</span>
								</div>
							)}
							<div class="flex flex-1 flex-col p-6">
								<span
									class={`inline-flex w-fit rounded-full px-3 py-1 text-xs font-semibold ${statusStyles[project.status] ?? "bg-stone-100 text-stone-600"}`}
								>
									{statusLabel(project.status)}
								</span>
								<h3 class="mt-4 text-xl font-semibold text-stone-900 transition-colors group-hover:text-brand-700">
									{project.title}
								</h3>
								<p class="mt-2 flex-1 text-sm leading-relaxed text-stone-600">
									{project.summary}
								</p>
								<span class="mt-4 inline-flex items-center text-sm font-semibold text-brand-600">
									Read more &rarr;
								</span>
							</div>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<!-- 5. Advantages strip -->
	<section class="bg-brand-950 text-white">
		<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
			<div
				class="grid grid-cols-1 gap-10 text-center sm:grid-cols-2 lg:grid-cols-4"
			>
				{
					advantages.slice(0, 4).map((advantage: any, i: number) => (
						<div class="flex flex-col items-center">
							<p class="text-5xl font-extrabold tracking-tight text-white">
								{advantage.stat ??
									advantageFallbacks[i]?.stat ??
									"—"}
							</p>
							<p class="mt-3 text-lg font-semibold text-brand-100">
								{advantage.title}
							</p>
							<p class="mt-2 text-sm leading-relaxed text-brand-200">
								{advantage.description ??
									advantageFallbacks[i]?.description ??
									""}
							</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- 6. Partner logos -->
	<section class="bg-white">
		<div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
			<p
				class="text-center text-sm font-semibold uppercase tracking-wider text-stone-500"
			>
				Trusted by
			</p>
			<div
				class="mt-8 grid grid-cols-2 items-center gap-6 sm:grid-cols-3 lg:grid-cols-5"
			>
				{
					Array.from({ length: 5 }).map(() => (
						<div class="flex h-16 items-center justify-center rounded-lg bg-stone-100">
							<span class="text-xs font-medium uppercase tracking-wider text-stone-400">
								Logo
							</span>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- 7. News teasers -->
	<section class="bg-stone-50">
		<div class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-2xl text-center">
				<span
					class="text-sm font-semibold uppercase tracking-wider text-brand-600"
				>
					Latest News
				</span>
				<h2
					class="mt-4 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl"
				>
					From the field
				</h2>
			</div>

			{
				latestNews.length > 0 ? (
					<div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-3">
						{latestNews.map((post: any) => (
							<a
								href={`/news/${post.slug}`}
								class="group flex flex-col overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm transition-shadow hover:shadow-md"
							>
								{post.mainImage ? (
									<img
										src={urlFor(post.mainImage)
											.width(700)
											.height(400)
											.fit("crop")
											.url()}
										alt={post.title}
										width="700"
										height="400"
										class="aspect-[7/4] w-full object-cover"
										loading="lazy"
									/>
								) : (
									<div class="aspect-[7/4] w-full bg-gradient-to-br from-stone-200 to-stone-100" />
								)}
								<div class="flex flex-1 flex-col p-6">
									<time class="text-xs font-medium uppercase tracking-wider text-stone-500">
										{formatDate(post.publishedAt)}
									</time>
									<h3 class="mt-2 text-lg font-semibold text-stone-900 transition-colors group-hover:text-brand-700">
										{post.title}
									</h3>
									<p class="mt-2 flex-1 text-sm leading-relaxed text-stone-600">
										{post.excerpt}
									</p>
									<span class="mt-4 inline-flex items-center text-sm font-semibold text-brand-600">
										Read more &rarr;
									</span>
								</div>
							</a>
						))}
					</div>
				) : (
					<p class="mt-12 text-center text-stone-500">
						No news yet — check back soon for updates from the
						research field.
					</p>
				)
			}
		</div>
	</section>

	<!-- 8. Final CTA -->
	<section class="bg-brand-800">
		<div
			class="mx-auto max-w-7xl px-4 py-20 text-center sm:px-6 lg:px-8"
		>
			<h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
				Interested in working with us?
			</h2>
			<p
				class="mx-auto mt-4 max-w-2xl text-lg leading-relaxed text-brand-100"
			>
				Whether you're a researcher, supplier or producer, we'd love to
				explore how digital twin technology can advance your work.
			</p>
			<div class="mt-10">
				<a
					href="/contact"
					class="inline-block rounded-lg bg-white px-8 py-3 text-base font-semibold text-brand-800 shadow-sm transition-colors hover:bg-stone-100"
				>
					Contact Us
				</a>
			</div>
		</div>
	</section>
</BaseLayout>
