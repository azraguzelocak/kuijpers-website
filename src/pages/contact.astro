---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.tsx";
import { getSiteSettings } from "../lib/sanity";

// --- Data fetching ------------------------------------------------------
// Pull contact details from Sanity site settings, with safe fallbacks.
const settings = (await getSiteSettings()) ?? {};

const email: string = settings.email ?? "info@kuijpersresearch.com";
const phone: string = settings.phone ?? "+31 (0)40 123 4567";
const address: string =
	settings.address ?? "Research Field 1\n5700 AA Helmond\nThe Netherlands";

const tel = phone.replace(/[^+\d]/g, "");

const details = [
	{
		label: "Email",
		value: email,
		href: `mailto:${email}`,
		icon: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
	},
	{
		label: "Phone",
		value: phone,
		href: `tel:${tel}`,
		icon: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>',
	},
	{
		label: "Address",
		value: address,
		href: null,
		icon: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
	},
];
---

<BaseLayout
	title="Contact — Kuijpers Research Field"
	description="Get in touch with Kuijpers Research Field. Send us a message and our team will get back to you about research, partnerships or digital twin technology."
>
	<!-- 1. Hero -->
	<section class="bg-stone-50">
		<div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
			<div class="mx-auto max-w-3xl text-center">
				<h1
					class="text-4xl font-extrabold tracking-tight text-stone-900 sm:text-5xl lg:text-6xl"
				>
					Get in Touch
				</h1>
				<p
					class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-stone-600 sm:text-xl"
				>
					Have a question about our research, want to explore a
					partnership, or curious how digital twin technology could support
					your work? Send us a message — we'd love to hear from you.
				</p>
			</div>
		</div>
	</section>

	<!-- 2. Form + contact info -->
	<section class="bg-white">
		<div class="mx-auto max-w-7xl px-4 pb-24 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 gap-12 lg:grid-cols-5 lg:gap-16">
				<!-- Left: form (interactive React island) -->
				<div class="lg:col-span-3">
					<div
						class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8"
					>
						<h2 class="text-2xl font-bold tracking-tight text-stone-900">
							Send us a message
						</h2>
						<p class="mt-2 text-base text-stone-600">
							Fill out the form below and we'll get back to you as soon
							as we can.
						</p>
						<div class="mt-6">
							<ContactForm client:load />
						</div>
					</div>
				</div>

				<!-- Right: contact info -->
				<div class="lg:col-span-2">
					<h2 class="text-2xl font-bold tracking-tight text-stone-900">
						Contact information
					</h2>
					<p class="mt-2 text-base text-stone-600">
						Prefer to reach us directly? Here's how to find us.
					</p>

					<ul class="mt-8 space-y-6">
						{
							details.map((item) => (
								<li class="flex gap-4">
									<div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
										<svg
											class="h-5 w-5"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
											aria-hidden="true"
											set:html={item.icon}
										/>
									</div>
									<div>
										<p class="text-sm font-semibold uppercase tracking-wider text-stone-500">
											{item.label}
										</p>
										{item.href ? (
											<a
												href={item.href}
												class="mt-1 block text-base text-stone-800 transition-colors hover:text-brand-600"
											>
												{item.value}
											</a>
										) : (
											<p class="mt-1 whitespace-pre-line text-base text-stone-800">
												{item.value}
											</p>
										)}
									</div>
								</li>
							))
						}
					</ul>

					<!-- Map placeholder -->
					<div
						class="mt-8 flex aspect-[4/3] w-full items-center justify-center overflow-hidden rounded-xl border border-stone-200 bg-stone-100"
					>
						<div class="text-center text-stone-400">
							<svg
								class="mx-auto h-8 w-8"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.5"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<path
									d="M14.106 5.553a2 2 0 0 0 1.788 0l3.659-1.83A1 1 0 0 1 21 4.619v12.764a1 1 0 0 1-.553.894l-4.553 2.277a2 2 0 0 1-1.788 0l-4.212-2.106a2 2 0 0 0-1.788 0l-3.659 1.83A1 1 0 0 1 3 19.381V6.618a1 1 0 0 1 .553-.894l4.553-2.277a2 2 0 0 1 1.788 0z"
								></path>
								<path d="M15 5.764v15"></path>
								<path d="M9 3.236v15"></path>
							</svg>
							<p class="mt-2 text-sm font-medium">Map coming soon</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
