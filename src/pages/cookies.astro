---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSiteSettings } from "../lib/sanity";

// --- Data fetching ------------------------------------------------------
// Pull contact details from Sanity site settings, with safe fallbacks.
const settings = (await getSiteSettings()) ?? {};

const company: string = settings.siteTitle ?? "Kuijpers Research Field";
const email: string = settings.email ?? "info@kuijpersresearch.com";

// Date this policy was last reviewed/updated.
const lastUpdated = "29 May 2026";
---

<BaseLayout
	title={`Cookie Policy — ${company}`}
	description={`How ${company} uses cookies. Our website uses privacy-friendly Plausible Analytics (no cookies) and does not use third-party tracking.`}
>
	<!-- Hero -->
	<section class="bg-stone-50">
		<div class="mx-auto max-w-3xl px-4 py-20 sm:px-6 lg:px-8">
			<p
				class="text-sm font-semibold uppercase tracking-wider text-brand-600"
			>
				Legal
			</p>
			<h1
				class="mt-3 text-4xl font-extrabold tracking-tight text-stone-900 sm:text-5xl"
			>
				Cookie Policy
			</h1>
			<p class="mt-4 text-base text-stone-500">
				Last updated: {lastUpdated}
			</p>
		</div>
	</section>

	<!-- Body -->
	<section class="bg-white">
		<div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
			<article
				class="space-y-10 text-base leading-relaxed text-stone-700
					[&_h2]:mt-2 [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:tracking-tight [&_h2]:text-stone-900
					[&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-stone-900
					[&_p]:mt-3
					[&_ul]:mt-3 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-6
					[&_a]:font-medium [&_a]:text-brand-600 [&_a:hover]:underline"
			>
				<div>
					<p class="mt-0">
						This cookie policy explains how {company} ("we", "us", "our")
						uses cookies and similar technologies on our website. We have
						deliberately built this website to be privacy-friendly, which
						means we use <strong>no tracking or advertising cookies</strong>.
					</p>
				</div>

				<!-- Highlight box -->
				<div
					class="rounded-xl border border-brand-100 bg-brand-50 p-6 text-stone-700"
				>
					<div class="flex items-start gap-3">
						<svg
							class="mt-0.5 h-6 w-6 shrink-0 text-brand-600"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M9 12l2 2 4-4" />
							<circle cx="12" cy="12" r="10" />
						</svg>
						<p class="mt-0">
							<strong class="text-stone-900"
								>This website does not use tracking cookies.</strong
							> You do not need to make any cookie choices to browse our
							site, and we do not show a cookie consent banner because
							none is legally required for the technologies we use.
						</p>
					</div>
				</div>

				<div>
					<h2>1. What are cookies?</h2>
					<p>
						Cookies are small text files that a website can place on your
						device to store information, for example to remember your
						preferences or to track your activity. Cookies that are
						strictly necessary for a website to function do not require
						consent, but tracking and analytics cookies generally do.
					</p>
				</div>

				<div>
					<h2>2. Cookies we use</h2>
					<p>
						We do not place any tracking, advertising or profiling cookies.
						The technologies we use are described below.
					</p>

					<h3 class="mt-6">Analytics — Plausible (no cookies)</h3>
					<p>
						We use <a
							href="https://plausible.io"
							target="_blank"
							rel="noopener noreferrer">Plausible Analytics</a
						> to understand how our website is used — for example, which
						pages are most visited. Plausible is a privacy-first analytics
						tool that:
					</p>
					<ul>
						<li>does <strong>not</strong> use cookies;</li>
						<li>does <strong>not</strong> collect any personal or personally identifiable information;</li>
						<li>does <strong>not</strong> track you across websites or devices;</li>
						<li>
							measures traffic using only aggregated, anonymous data,
							and is fully compliant with the GDPR and the ePrivacy
							Directive.
						</li>
					</ul>
					<p>
						Because Plausible does not use cookies and does not process
						personal data, no consent is required for it.
					</p>

					<h3 class="mt-6">Content management — Sanity (no tracking)</h3>
					<p>
						The content on this website is managed and delivered through <a
							href="https://www.sanity.io"
							target="_blank"
							rel="noopener noreferrer">Sanity</a
						>. Sanity serves our content and does not place third-party
						tracking cookies or profile visitors of this website.
					</p>
				</div>

				<div>
					<h2>3. Third-party cookies</h2>
					<p>
						We do not embed third-party advertising, social media tracking
						pixels or similar technologies that would set cookies on your
						device. If we add any feature in the future that requires
						cookies or consent, we will update this policy and request
						your consent where the law requires it.
					</p>
				</div>

				<div>
					<h2>4. Managing cookies in your browser</h2>
					<p>
						Even though our website does not set tracking cookies, you can
						control and delete cookies through your browser settings at any
						time. Most browsers let you block or remove cookies and notify
						you when a site tries to set one. Refer to your browser's help
						pages for instructions:
					</p>
					<ul>
						<li>
							<a
								href="https://support.google.com/chrome/answer/95647"
								target="_blank"
								rel="noopener noreferrer">Google Chrome</a
							>
						</li>
						<li>
							<a
								href="https://support.mozilla.org/en-US/kb/cookies-information-websites-store-on-your-computer"
								target="_blank"
								rel="noopener noreferrer">Mozilla Firefox</a
							>
						</li>
						<li>
							<a
								href="https://support.apple.com/guide/safari/manage-cookies-sfri11471/mac"
								target="_blank"
								rel="noopener noreferrer">Apple Safari</a
							>
						</li>
						<li>
							<a
								href="https://support.microsoft.com/en-us/microsoft-edge/delete-cookies-in-microsoft-edge-63947406-40ac-c3b8-57b9-2a946a29ae09"
								target="_blank"
								rel="noopener noreferrer">Microsoft Edge</a
							>
						</li>
					</ul>
				</div>

				<div>
					<h2>5. Changes to this policy</h2>
					<p>
						We may update this cookie policy from time to time to reflect
						changes in the technologies we use or in the law. When we do,
						we will revise the "last updated" date at the top of this page.
					</p>
				</div>

				<div>
					<h2>6. Questions?</h2>
					<p>
						If you have any questions about our use of cookies, or about
						how we handle data more generally, please see our <a
							href="/privacy">Privacy Policy</a
						> or contact us:
					</p>
					<p>
						Email: <a href={`mailto:${email}`}>{email}</a>
					</p>
				</div>
			</article>
		</div>
	</section>
</BaseLayout>
