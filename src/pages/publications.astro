---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAllPublications } from "../lib/sanity";

// --- Data fetching ------------------------------------------------------
const publications = (await getAllPublications()) ?? [];

// --- Type presentation --------------------------------------------------
// Maps the CMS `publicationType` enum to a label and badge colour. Kept as
// one source of truth for both the badges and the type filter.
const TYPE_META: Record<string, { label: string; badge: string }> = {
	paper: {
		label: "Paper",
		badge: "bg-brand-100 text-brand-800 ring-brand-600/20",
	},
	report: {
		label: "Report",
		badge: "bg-emerald-100 text-emerald-800 ring-emerald-600/20",
	},
	article: {
		label: "Article",
		badge: "bg-amber-100 text-amber-800 ring-amber-600/20",
	},
};
const typeMeta = (type: string) =>
	TYPE_META[type] ?? {
		label: type ?? "Other",
		badge: "bg-stone-100 text-stone-700 ring-stone-500/20",
	};

const typeFilters = [
	{ value: "all", label: "All types" },
	{ value: "paper", label: "Papers" },
	{ value: "report", label: "Reports" },
	{ value: "article", label: "Articles" },
];

// --- Helpers ------------------------------------------------------------
// Authors come from two sources: linked team members (references) and free
// text strings. Combine both into a single comma-separated byline.
const authorNames = (pub: any): string => {
	const team = (pub.teamAuthors ?? [])
		.map((a: any) => a?.name)
		.filter(Boolean);
	const free = Array.isArray(pub.authors)
		? pub.authors.filter(Boolean)
		: pub.authors
			? [pub.authors]
			: [];
	return [...team, ...free].join(", ");
};

const fmtDate = (d?: string) =>
	d
		? new Date(d).toLocaleDateString("en-GB", {
				year: "numeric",
				month: "short",
				day: "numeric",
			})
		: null;

const yearOf = (pub: any): string =>
	pub.publicationDate ? String(new Date(pub.publicationDate).getFullYear()) : "";

// Truncate the abstract to a short preview.
const preview = (text?: string, max = 220): string => {
	if (!text) return "";
	const clean = text.trim();
	return clean.length > max ? clean.slice(0, max).trimEnd() + "…" : clean;
};

// Year filter — current year and the four preceding years, but only those
// that actually have publications so we never show an empty year tab.
const currentYear = new Date().getFullYear();
const lastFiveYears = Array.from({ length: 5 }, (_, i) =>
	String(currentYear - i),
);
const availableYears = new Set(
	publications.map(yearOf).filter(Boolean),
);
const yearFilters = [
	{ value: "all", label: "All years" },
	...lastFiveYears
		.filter((y) => availableYears.has(y))
		.map((y) => ({ value: y, label: y })),
];
---

<BaseLayout
	title="Publications — Kuijpers Research Field"
	description="Peer-reviewed papers, technical reports and articles from the Kuijpers Research Field — the validated science behind our digital twin."
>
	<!-- 1. Hero -->
	<section class="relative overflow-hidden bg-stone-900">
		<!-- Full-bleed background photograph -->
		<img
			src="/images/publication-hero.png"
			alt=""
			aria-hidden="true"
			class="absolute inset-0 h-full w-full object-cover"
			loading="eager"
		/>
		<!-- Cinematic dark overlay for legibility -->
		<div
			class="absolute inset-0 bg-gradient-to-b from-stone-950/70 via-stone-950/55 to-stone-950/75"
		>
		</div>
		<div
			class="relative mx-auto max-w-7xl px-4 py-28 sm:px-6 sm:py-32 lg:px-8"
		>
			<div class="mx-auto max-w-3xl text-center">
				<h1
					class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl"
				>
					Publications
				</h1>
				<p
					class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-stone-200 sm:text-xl"
				>
					Peer-reviewed papers, technical reports and articles that
					document our methods and results. This is the validated
					science behind everything we build — browse, read and
					download below.
				</p>
			</div>
		</div>
	</section>

	<!-- 1b. Intro block -->
	<section class="bg-stone-50">
		<div
			class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 lg:px-8 lg:py-28"
		>
			<span
				class="text-sm font-semibold uppercase tracking-[0.15em] text-brand-600"
			>
				Knowledge
			</span>
			<h2
				class="mt-5 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl lg:text-[3.25rem] lg:leading-[1.1]"
			>
				The science, <span class="text-brand-600">in writing</span>.
			</h2>
			<p
				class="mx-auto mt-6 max-w-[680px] text-lg leading-[1.65] text-stone-600"
			>
				Peer-reviewed papers, technical reports, and articles documenting
				our methods, our findings, and our willingness to publish them in
				full. Browse, read, and download what we've put on the record.
			</p>
		</div>
	</section>

	<!-- 2. Filter bar + publication list -->
	<section class="bg-white">
		<div class="mx-auto max-w-5xl px-4 py-16 sm:px-6 lg:px-8">
			{
				publications.length > 0 ? (
					<>
						{/* Filter bar */}
						<div class="flex flex-col gap-6 border-b border-stone-200 pb-8 sm:flex-row sm:items-end sm:justify-between">
							{/* Type filter */}
							<div>
								<p class="mb-2 text-xs font-semibold uppercase tracking-wide text-stone-500">
									Type
								</p>
								<div
									id="type-filter"
									class="flex flex-wrap gap-2"
									role="tablist"
									aria-label="Filter publications by type"
								>
									{typeFilters.map((filter) => (
										<button
											type="button"
											class="type-filter-btn rounded-full border border-stone-200 px-4 py-1.5 text-sm font-semibold text-stone-600 transition-colors hover:bg-stone-50 aria-selected:border-brand-600 aria-selected:bg-brand-600 aria-selected:text-white"
											data-type={filter.value}
											role="tab"
											aria-selected={filter.value === "all"}
										>
											{filter.label}
										</button>
									))}
								</div>
							</div>

							{/* Year filter */}
							<div>
								<p class="mb-2 text-xs font-semibold uppercase tracking-wide text-stone-500">
									Year
								</p>
								<div
									id="year-filter"
									class="flex flex-wrap gap-2"
									role="tablist"
									aria-label="Filter publications by year"
								>
									{yearFilters.map((filter) => (
										<button
											type="button"
											class="year-filter-btn rounded-full border border-stone-200 px-4 py-1.5 text-sm font-semibold text-stone-600 transition-colors hover:bg-stone-50 aria-selected:border-brand-600 aria-selected:bg-brand-600 aria-selected:text-white"
											data-year={filter.value}
											role="tab"
											aria-selected={filter.value === "all"}
										>
											{filter.label}
										</button>
									))}
								</div>
							</div>
						</div>

						{/* Publication list */}
						<ul id="publication-list" class="mt-8 space-y-6">
							{publications.map((pub: any) => {
								const meta = typeMeta(pub.publicationType);
								const authors = authorNames(pub);
								const date = fmtDate(pub.publicationDate);
								return (
									<li
										class="publication-card rounded-xl border border-stone-200 bg-white p-6 shadow-sm transition-shadow hover:shadow-md"
										data-type={pub.publicationType ?? "other"}
										data-year={yearOf(pub)}
									>
										<div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
											<div class="min-w-0 flex-1">
												<div class="flex flex-wrap items-center gap-3">
													<span
														class={`inline-flex items-center rounded-full px-3 py-1 text-xs font-semibold ring-1 ring-inset ${meta.badge}`}
													>
														{meta.label}
													</span>
													{date && (
														<span class="text-sm text-stone-500">
															{date}
														</span>
													)}
												</div>

												<h2 class="mt-3 text-xl font-semibold text-stone-900">
													{pub.title}
												</h2>

												{authors && (
													<p class="mt-1 text-sm font-medium text-stone-600">
														{authors}
													</p>
												)}

												{pub.venue && (
													<p class="mt-1 text-sm italic text-stone-500">
														{pub.venue}
													</p>
												)}

												{pub.abstract && (
													<p class="mt-3 text-base leading-relaxed text-stone-600">
														{preview(pub.abstract)}
													</p>
												)}
											</div>

											{/* Action button */}
											<div class="flex-shrink-0">
												{pub.pdfUrl ? (
													<a
														href={pub.pdfUrl}
														target="_blank"
														rel="noopener noreferrer"
														class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-700"
													>
														<svg
															class="h-4 w-4"
															viewBox="0 0 24 24"
															fill="none"
															stroke="currentColor"
															stroke-width="2"
															stroke-linecap="round"
															stroke-linejoin="round"
															aria-hidden="true"
														>
															<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
															<path d="M7 10l5 5 5-5" />
															<path d="M12 15V3" />
														</svg>
														Download PDF
													</a>
												) : pub.url ? (
													<a
														href={pub.url}
														target="_blank"
														rel="noopener noreferrer"
														class="inline-flex items-center gap-2 rounded-lg border border-brand-600 px-4 py-2 text-sm font-semibold text-brand-700 transition-colors hover:bg-brand-50"
													>
														<svg
															class="h-4 w-4"
															viewBox="0 0 24 24"
															fill="none"
															stroke="currentColor"
															stroke-width="2"
															stroke-linecap="round"
															stroke-linejoin="round"
															aria-hidden="true"
														>
															<path d="M15 3h6v6" />
															<path d="M10 14 21 3" />
															<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
														</svg>
														View externally
													</a>
												) : null}
											</div>
										</div>
									</li>
								);
							})}
						</ul>

						{/* Empty state shown by the script when filters exclude everything */}
						<p
							id="filter-empty"
							class="mt-12 hidden text-center text-stone-500"
						>
							No publications match these filters yet — try widening
							your selection.
						</p>
					</>
				) : (
					<p class="text-center text-stone-500">
						Publications are coming soon — check back shortly.
					</p>
				)
			}
		</div>
	</section>
</BaseLayout>

<script>
	// --- Combined type + year filtering ----------------------------------
	// Two independent filter rows; a card is visible only if it matches both
	// the active type and the active year.
	const typeButtons = Array.from(
		document.querySelectorAll<HTMLButtonElement>(".type-filter-btn"),
	);
	const yearButtons = Array.from(
		document.querySelectorAll<HTMLButtonElement>(".year-filter-btn"),
	);
	const cards = Array.from(
		document.querySelectorAll<HTMLElement>(".publication-card"),
	);
	const empty = document.getElementById("filter-empty");

	let activeType = "all";
	let activeYear = "all";

	function apply() {
		let visible = 0;
		for (const card of cards) {
			const typeOk =
				activeType === "all" || card.dataset.type === activeType;
			const yearOk =
				activeYear === "all" || card.dataset.year === activeYear;
			const match = typeOk && yearOk;
			card.classList.toggle("hidden", !match);
			if (match) visible++;
		}
		if (empty) empty.classList.toggle("hidden", visible > 0);
	}

	function select(
		buttons: HTMLButtonElement[],
		attr: "type" | "year",
		value: string,
	) {
		for (const btn of buttons) {
			btn.setAttribute(
				"aria-selected",
				String(btn.dataset[attr] === value),
			);
		}
	}

	for (const btn of typeButtons) {
		btn.addEventListener("click", () => {
			activeType = btn.dataset.type ?? "all";
			select(typeButtons, "type", activeType);
			apply();
		});
	}
	for (const btn of yearButtons) {
		btn.addEventListener("click", () => {
			activeYear = btn.dataset.year ?? "all";
			select(yearButtons, "year", activeYear);
			apply();
		});
	}
</script>
